# ──────────────── .env.example — Lucams Shop ────────────────
# COPIAR a `.env.local` y completar con valores reales. NUNCA commitear `.env.local`.
# Matriz canónica de variables y secretos en docs/OPERATIONS.md y docs/SECURITY.md.

# ──────────────── App ────────────────
# Modo de tienda (ADR-077). OBLIGATORIA y explícita en producción: validateEnv() aborta el arranque
# si falta o trae un valor distinto de estos dos.
#   catalog = Etapa 1: catálogo + cotización por WhatsApp. Sin pagos, envíos ni IA. Las Server
#             Actions transaccionales quedan bloqueadas server-side (lib/stage-guard.ts), no solo
#             ocultas.
#   full    = Etapa 2 (modo vigente en PRD/STG): tienda completa con Wompi + Aveonline + IA.
#             Exige además el bloque FULL_MODE_REQUIRED en producción.
# En dev, si se omite, el código asume "full".
NEXT_PUBLIC_STORE_MODE=full

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://lucamsshop.com   # producción

NEXT_PUBLIC_WA_NUMBER=573208873826              # WhatsApp (sin + ni espacios; formato wa.me)

NODE_ENV=development                            # development | production
LOG_LEVEL=info                                  # debug | info | warn | error
NEXT_TELEMETRY_DISABLED=1                       # apaga telemetría anónima de Next.js

# Mantenimiento: exactamente "1" muestra la página de mantenimiento a todo el sitio
# (proxy.ts compara === "1" — "true" NO lo activa).
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Versión de build pública (badge "v<sha>" en el footer). OPCIONAL:
#   - En Vercel no hay que setearla: next.config.ts la expone desde VERCEL_GIT_COMMIT_SHA.
#   - En local/CI se puede definir explícita; si está vacía, el footer omite el badge.
# NEXT_PUBLIC_BUILD_VERSION=PLACEHOLDER
NEXT_PUBLIC_GIT_SHA=dev

# Puerto del dev server local. Next NO la lee del .env — `make web-start` la exporta
# al shell (source .env.local) antes de `pnpm dev`. Sin ella, Next arranca en :3000.
PORT=4000

# ──────────────── Supabase y Prisma ────────────────
# Sacar valores del panel: Project Settings → API + Database → Connection string
# Detalle completo en docs/integrations/supabase.md
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
DATABASE_URL=postgresql://postgres:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Tope del pool de conexiones de Prisma POR PROCESO (default 5 si se omite — ADR-131).
# En Vercel cada lambda abre su propio pool contra Supavisor (:6543, transaction mode).
# Aplica SOLO a DATABASE_URL; las migraciones usan DIRECT_URL intacta.
# Si DATABASE_URL ya trae `connection_limit=` o `pool_timeout=` explícitos, esos valores mandan.
# PRISMA_CONNECTION_LIMIT=5
# PRISMA_POOL_TIMEOUT=20
# PRISMA_LOG=                                   # "query" habilita logs SQL detallados en dev

# ──────────────── Wompi (pagos en línea) ────────────────
# Sacar valores del panel Wompi: Desarrolladores → Llaves del comercio
# Detalle completo en docs/integrations/wompi.md
PAYMENT_PROVIDER=wompi                          # único proveedor activo hoy (features/payments/provider)
WOMPI_ENV=sandbox                               # sandbox | production
WOMPI_PUBLIC_KEY=pub_test_PLACEHOLDER
WOMPI_PRIVATE_KEY=prv_test_PLACEHOLDER
WOMPI_INTEGRITY_SECRET=test_integrity_PLACEHOLDER
WOMPI_EVENTS_SECRET=test_events_PLACEHOLDER
# (La llave pública de Wompi NO se expone como NEXT_PUBLIC_WOMPI_*: el servidor construye
# la URL firmada hacia el Web Checkout alojado de Wompi.)
#
# Escape hatch SOLO para depuración local (tests/smokes que firman un timestamp viejo):
# en "true" DESACTIVA la validación anti-replay (ventana de 25h) del webhook de Wompi.
# NUNCA en producción: lib/env.ts aborta el arranque si vale "true" con VERCEL_ENV=production.
WOMPI_DISABLE_TIMESTAMP_CHECK=false

# ──────────────── Aveonline (logística multi-carrier) ────────────────
# Detalle completo en docs/integrations/aveonline.md
#
# UN SOLO SET de credenciales cuyo VALOR cambia por ambiente:
#   - dev/stg/preview: cuenta DEMO pública de Aveonline (documentada por el proveedor).
#   - producción: credenciales reales de Lucams Shop.
AVEONLINE_USUARIO=demointegracion
AVEONLINE_CLAVE=demointegra2021
# AVEONLINE_USUARIO=PLACEHOLDER                 # producción (cuenta real)
# AVEONLINE_CLAVE=PLACEHOLDER                   # producción (cuenta real)

# AVEONLINE_ENV = modo DECLARADO (no selecciona credenciales):
#   - "test" (default): el health check acepta la cuenta demo (idempresa 15289) como válida.
#   - "production": exige que la cuenta autenticada NO sea la demo (guard anti-misconfig).
AVEONLINE_ENV=test

# Doble compuerta de facturación real en generarGuia2:
#   - Sin setear / false (default): `bloquegenerarguia=1` → NO factura cartera real.
#   - "true" + NODE_ENV=production: `bloquegenerarguia=0` → genera guía FACTURABLE real.
AVEONLINE_GENERATE_REAL=false
# Escape hatch PELIGROSO para facturar real desde NODE_ENV !== "production" (combinado con
# AVEONLINE_GENERATE_REAL=true). Mantener siempre en false salvo prueba puntual autorizada.
AVEONLINE_FORCE_BILLING=false

# Secreto compartido para autenticar /api/webhooks/aveonline (`openssl rand -hex 32`).
AVEONLINE_WEBHOOK_SECRET=PLACEHOLDER

# Transitorio: en "true" acepta el secreto por ?secret= en la URL además de header/body.
# Default OFF (recomendado) para no exponer el secreto en access logs.
AVEONLINE_ALLOW_QUERY_SECRET=false

# ──────────────── Resend (correo transaccional y boletín) ────────────────
# Detalle completo en docs/integrations/resend-and-emails.md
RESEND_API_KEY=re_PLACEHOLDER
EMAIL_FROM="Lucams Shop <onboarding@resend.dev>"
# EMAIL_FROM="Lucams Shop <hola@mail.lucamsshop.com>"  # producción (subdominio verificado)
# Buzón real receptor: mail.lucamsshop.com es solo de envío; las respuestas entran por
# Cloudflare Email Routing en hola@lucamsshop.com (PROD_REQUIRED).
EMAIL_REPLY_TO="hola@lucamsshop.com"

# Webhook Svix de Resend (/api/webhooks/resend) para rebotes, quejas y entregas (PROD_REQUIRED).
RESEND_WEBHOOK_SECRET=whsec_PLACEHOLDER

# Segmento opcional de Resend Contacts para suscriptores del boletín (dashboard → Segments).
# RESEND_NEWSLETTER_SEGMENT_ID=seg_xxxxxxxxxxxx

# Kill-switch local/E2E: en "1" o "true" suprime todo envío saliente a Resend devolviendo un id simulado.
# EMAIL_SEND_DISABLED=0

# ──────────────── Cloudflare Turnstile (anti-bot) ────────────────
# Detalle completo en docs/integrations/cloudflare.md
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxx

# ──────────────── Cloudflare R2 (backups cifrados off-site — solo scripts/GHA) ────────────────
R2_ACCOUNT_ID=PLACEHOLDER
R2_ACCESS_KEY_ID=PLACEHOLDER
R2_SECRET_ACCESS_KEY=PLACEHOLDER
R2_BUCKET=lucams-backups

# Opcionales para backup manual (`pnpm db:backup` / `pnpm --filter web storage:backup`) y DR drill:
# BACKUP_DATABASE_URL=                          # default: DIRECT_URL
# BACKUP_PREFIX=db                              # Storage usa "<BACKUP_PREFIX>-storage"
# BACKUP_KEEP=8                                 # workflow diario en GHA usa 30 (~1 mes)
# BACKUP_SUPABASE_URL=                          # fallback local: NEXT_PUBLIC_SUPABASE_URL
# BACKUP_SUPABASE_SECRET_KEY=                   # fallback local: SUPABASE_SECRET_KEY
# BACKUP_STORAGE_BUCKETS=customer-uploads,production-assets,design-previews,cms-media,product-images
# BACKUP_GPG_PASSPHRASE=                        # obligatoria (fail-closed) al correr el backup
# DRILL_DATABASE_URL=                           # solo CI (dr-drill.yml)
# DRILL_MIN_PRODUCTS=5                          # piso detector de dumps vacíos
# DRILL_STORAGE_BUCKET=                         # solo CI (dr-drill-storage.mjs)

# ──────────────── Seguridad, Crons y Retención ────────────────
# Generar ambos con: openssl rand -hex 32
CSRF_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
CRON_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32

# Jobs de CRON_JOBS (features/observability/cron-heartbeat.ts) deshabilitados a propósito en este
# ambiente para no disparar falsos "overdue" en /api/health/crons:
#   - PRD: vacía (todos activos)
#   - STG: CRON_JOBS_DISABLED=alerts,daily-summary,review-request,cart-recovery,back-in-stock
#   - Local: CRON_JOBS_DISABLED=daily-summary,review-request,purge-anon-designs,purge-event-logs,purge-delivered-designs
# CRON_JOBS_DISABLED=

# Lifecycle Journeys: VERCEL_ENV=preview siempre ejecuta en modo de prueba sin llamar a Resend.
# En local o PRD, "1"/"true" fuerza el mismo modo (registra DRY_RUN, no envía correos ni crea tareas).
# LIFECYCLE_DRY_RUN=0

# Días de gracia para purgas de diseños/fotos del Estudio (Ley 1581):
# PURGE_IDLE_DESIGN_AFTER_DAYS=90               # borradores inactivos de cuentas registradas
# PURGE_DELIVERED_DESIGN_AFTER_DAYS=90          # fotos crudas + renders tras entrega del pedido

# ──────────────── Google (Gemini IA, GA4 y Search Console) ────────────────
# Detalle completo en docs/integrations/google-and-ai.md
# Asistente IA del Estudio + Copiloto interno de soporte (0 PII). Server-only:
GEMINI_API_KEY=PLACEHOLDER
GEMINI_MODEL_PRIMARY=gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-2.5-flash

# Google Search Console — token meta `google-site-verification` (opcional):
# GOOGLE_SITE_VERIFICATION=PLACEHOLDER

# Google Analytics 4 — Measurement ID (opcional; carga gtag.js SOLO tras opt-in en "Analíticas"):
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ──────────────── CI / Smokes contra Preview o STG (no va en producción) ────────────────
# Secreto de Deployment Protection de Vercel (header x-vercel-protection-bypass) para smokes E2E,
# k6 y monitor externo de uptime desde STG.
# VERCEL_BYPASS_TOKEN=PLACEHOLDER
