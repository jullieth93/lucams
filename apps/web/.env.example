# ──────────────── .env.example — Lucams_shop ────────────────
# COPIAR a `.env.local` y completar con valores reales. NUNCA commitear `.env.local`.
# Ver convenciones en docs/OPERATIONS.md y docs/SECURITY.md (manejo de secretos).

# ──────────────── App ────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://lucamsshop.com  # producción

NEXT_PUBLIC_WA_NUMBER=573208873826              # WhatsApp (sin + ni espacios; formato wa.me)

NODE_ENV=development                            # development | production
LOG_LEVEL=info                                  # debug | info | warn | error
NEXT_TELEMETRY_DISABLED=1                       # apaga telemetría anónima de Next.js

# ──────────────── Supabase ────────────────
# Sacar valores del panel: Project Settings → API + Database → Connection string
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
DATABASE_URL=postgresql://postgres:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ──────────────── Wompi ────────────────
# Sacar valores del panel Wompi: Comercio → Llaves
WOMPI_ENV=sandbox                               # sandbox | production
WOMPI_PUBLIC_KEY=pub_test_PLACEHOLDER
WOMPI_PRIVATE_KEY=prv_test_PLACEHOLDER
WOMPI_INTEGRITY_SECRET=test_integrity_PLACEHOLDER
WOMPI_EVENTS_SECRET=test_events_PLACEHOLDER
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=${WOMPI_PUBLIC_KEY}

# ──────────────── Venndelo ────────────────
# Doc OpenAPI: https://api.venndelo.com/v1/admin/openapi-json
# Solo existe ambiente producción (no hay sandbox per confirmación 2026-05-13).
# API Key se obtiene por contacto con soporte Venndelo (no autoservicio).
VENNDELO_ENV=production                         # solo producción (no hay sandbox)
VENNDELO_API_URL=https://api.venndelo.com/v1    # paths del spec: /admin/...
VENNDELO_API_KEY=PLACEHOLDER

# Webhooks: la doc OpenAPI pública NO los documenta. Pendiente confirmar con
# soporte si existen. Mientras tanto el código usa polling (pg_cron) para
# sync de tracking. Si soporte confirma webhooks, descomentar y agregar valor.
# VENNDELO_WEBHOOK_SECRET=

# Dirección de origen para recolección (de donde el courier recoge paquetes).
# city_code + subdivision_code en formato DANE Colombia. Validar contra
# /v1/admin/region/cities (catálogo Venndelo). Bogotá D.C. = code 11001000.
# Nota: el catálogo Venndelo agrupa Bogotá bajo subdivision_code='25'
# (Cundinamarca) pero acepta '11' (DANE oficial Distrito Capital) sin error.
# Usamos '11' por consistencia legal/DIAN.
VENNDELO_PICKUP_ADDRESS_LINE=Calle 0 # 00-00
VENNDELO_PICKUP_CITY_CODE=11001000              # DANE Bogotá
VENNDELO_PICKUP_SUBDIVISION_CODE=11             # DANE Bogotá D.C. (depto 2 dígitos)
VENNDELO_PICKUP_COUNTRY_CODE=CO                 # ISO 3166-1 alpha-2
VENNDELO_PICKUP_CONTACT_NAME=PLACEHOLDER
VENNDELO_PICKUP_CONTACT_PHONE=3000000000        # 10 dígitos, sin '+' ni código país

# ──────────────── Aveonline (logística multi-carrier) ────────────────
# Doc: docs/INTEGRATIONS_AVEONLINE.md (1.007 líneas)
#
# AVEONLINE_ENV controla credenciales:
#   - "test" (default): cuenta demo pública `demointegracion/demointegra2021`
#   - "production": usa AVEONLINE_USUARIO/CLAVE reales (cuenta Lucams Shop)
AVEONLINE_ENV=test
AVEONLINE_USUARIO=PLACEHOLDER
AVEONLINE_CLAVE=PLACEHOLDER

# AVEONLINE_GENERATE_REAL controla FACTURACIÓN (Lucy 2026-06-26 — doble gate seguro):
#   Sin setear / false (default): `bloquegenerarguia=1` → NO factura aunque genere
#     guía + PDF visible. Modo correcto para dev/preview/staging.
#   "true" + NODE_ENV=production: `bloquegenerarguia=0` → genera guía FACTURABLE
#     (cartera real en Aveonline). Setear SOLO cuando launch productivo confirmado.
# AVEONLINE_GENERATE_REAL=false
#
# AVEONLINE_FORCE_BILLING (escape hatch — dev avanzado):
#   "true" permite facturar real DESDE DEV (combinado con AVEONLINE_GENERATE_REAL=true).
#   Útil para una prueba E2E final pre-launch sin tener que deployear. PELIGROSO.
# AVEONLINE_FORCE_BILLING=false

# AVEONLINE_WEBHOOK_SECRET (Lucy 2026-05-25):
#   HMAC para validar webhook tracking entrante (/api/webhooks/aveonline?secret=X).
#   Generar con `openssl rand -hex 32`. Registrar en panel Aveonline al crear webhook.
AVEONLINE_WEBHOOK_SECRET=PLACEHOLDER

# ──────────────── Resend ────────────────
RESEND_API_KEY=re_PLACEHOLDER
EMAIL_FROM="Lucams_shop <onboarding@resend.dev>"
# EMAIL_FROM=Lucams_shop <hola@mail.lucamsshop.com>  # producción al verificar dominio

# Newsletter — opcional. Si se setea, los suscriptores se asocian al
# Segment indicado. Si no, quedan en el pool general del workspace.
# Resend migró de "Audiences" (legacy) a "Segments" — crear desde
# dashboard.resend.com → Segments → New segment.
# RESEND_NEWSLETTER_SEGMENT_ID=seg_xxxxxxxxxxxx

# ──────────────── Anthropic (Claude API) ────────────────
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER
ANTHROPIC_MODEL=claude-sonnet-4-6               # verificar contra anthropic.com/pricing

# ──────────────── Cloudflare Turnstile (CAPTCHA) ────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxx

# ──────────────── Cloudflare R2 (backups en producción) ────────────────
R2_ACCOUNT_ID=PLACEHOLDER
R2_ACCESS_KEY_ID=PLACEHOLDER
R2_SECRET_ACCESS_KEY=PLACEHOLDER
R2_BUCKET=lucams-backups

# ──────────────── CSRF ────────────────
# Generar con: openssl rand -hex 32
CSRF_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32

# Secreto compartido con los jobs de pg_cron (header x-cron-secret). OBLIGATORIO en producción:
# sin él la app no arranca (lib/env.ts PROD_REQUIRED) y las alertas/resumen diario no corren.
CRON_SECRET=genera-uno-largo-y-aleatorio

# ──────────────── Misc ────────────────
# Toggle de features flag-driven (cuando se necesiten)
# FEATURE_AI_DESIGN_SUGGEST=true

# Asistente IA de sugerencias de diseño (ADR-058) — proveedor Gemini (nivel gratuito para dev).
# La key es SERVER-ONLY (fetch servidor→Google). Sin ella, el asistente cae a "no disponible"
# (nunca rompe el editor). Fallback entre modelos: primario → respaldo.
GEMINI_API_KEY=PLACEHOLDER
GEMINI_MODEL_PRIMARY=gemini-2.5-flash-lite    # primario (barato / free-tier)
GEMINI_MODEL_FALLBACK=gemini-2.5-flash         # respaldo si el primario falla
