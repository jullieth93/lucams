# ──────────────── .env.example — Lucams_shop ────────────────
# COPIAR a `.env.local` y completar con valores reales. NUNCA commitear `.env.local`.
# Ver convenciones en docs/OPERATIONS.md y docs/SECURITY.md (manejo de secretos).

# ──────────────── App ────────────────
# Modo de tienda (ADR-077). OBLIGATORIA y explícita en producción: validateEnv() aborta el arranque
# si falta o trae un valor distinto de estos dos.
#   catalog = Etapa 1: catálogo + cotización por WhatsApp. Sin pagos, envíos ni IA. Las Server
#             Actions transaccionales quedan bloqueadas server-side (lib/stage-guard.ts), no solo
#             ocultas. NOTA: producción corre en `full` por decisión de Lucy (2026-09-03).
#   full    = Etapa 2: tienda completa con Wompi + Aveonline. Exige además el bloque FULL_MODE.
# En dev, si se omite, el código asume "full" (fail-open deliberado: un typo no debe apagarle el
# checkout a una tienda que sí vende).
NEXT_PUBLIC_STORE_MODE=catalog

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://lucamsshop.com  # producción

NEXT_PUBLIC_WA_NUMBER=573208873826              # WhatsApp (sin + ni espacios; formato wa.me)

NODE_ENV=development                            # development | production
LOG_LEVEL=info                                  # debug | info | warn | error
NEXT_TELEMETRY_DISABLED=1                       # apaga telemetría anónima de Next.js

# Puerto del dev server local. Next NO la lee del .env — `make web-start` la exporta
# al shell (source .env.local) antes de `pnpm dev`. Sin ella, Next arranca en :3000.
PORT=4000

# ──────────────── Supabase ────────────────
# Sacar valores del panel: Project Settings → API + Database → Connection string
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
DATABASE_URL=postgresql://postgres:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Tope del pool de conexiones de Prisma POR PROCESO (default 3 si se omite). En Vercel cada
# lambda abre su propio pool contra el pooler (6543, pgbouncer transaction mode) y el default
# de Prisma (num_cpus×2+1 por lambda) agota los slots upstream del pooler bajo pico — F-14.
# Aplica SOLO a la conexión runtime (DATABASE_URL); las migraciones usan DIRECT_URL intacta.
# Si DATABASE_URL ya trae `connection_limit=` explícito, ese valor manda sobre esta variable.
# PRISMA_CONNECTION_LIMIT=3

# ──────────────── Wompi ────────────────
# Sacar valores del panel Wompi: Comercio → Llaves
WOMPI_ENV=sandbox                               # sandbox | production
WOMPI_PUBLIC_KEY=pub_test_PLACEHOLDER
WOMPI_PRIVATE_KEY=prv_test_PLACEHOLDER
WOMPI_INTEGRITY_SECRET=test_integrity_PLACEHOLDER
WOMPI_EVENTS_SECRET=test_events_PLACEHOLDER
# (La llave pública de Wompi NO necesita exponerse al navegador: el checkout es
# redirección al hosted checkout de Wompi. No declarar NEXT_PUBLIC_WOMPI_*.)
# Escape hatch SOLO para depuración local (tests/smokes que firman un timestamp viejo):
# en "true" DESACTIVA la validación anti-replay del timestamp del webhook de Wompi
# (la ventana de frescura de event.timestamp en app/api/webhooks/wompi/route.ts).
# NUNCA en producción: con el anti-replay apagado el webhook aceptaría eventos
# re-enviados/forjados. lib/env.ts hace fail-fast si está en "true" con NODE_ENV=production.
# Default (ausente o cualquier valor distinto de "true") = validación ACTIVA.
WOMPI_DISABLE_TIMESTAMP_CHECK=false

# ──────────────── Aveonline (logística multi-carrier) ────────────────
# Doc: docs/INTEGRATIONS_AVEONLINE.md (1.007 líneas)
#
# UN SOLO SET de credenciales cuyo VALOR cambia por ambiente (refactor 2026-08):
#   - dev/stg/preview: la cuenta DEMO pública de Aveonline (valores de abajo,
#     documentados por Aveonline — no son secreto).
#   - producción: las credenciales reales de Lucams Shop.
AVEONLINE_USUARIO=demointegracion
AVEONLINE_CLAVE=demointegra2021
# AVEONLINE_USUARIO=PLACEHOLDER   # producción (cuenta real)
# AVEONLINE_CLAVE=PLACEHOLDER     # producción (cuenta real)
#
# AVEONLINE_ENV = modo DECLARADO (no selecciona credenciales):
#   - "test" (default): el health check acepta la cuenta demo como válida.
#   - "production": el health check exige que la cuenta autenticada NO sea la
#     demo (guard anti-misconfig: credenciales demo en prod = error explícito).
AVEONLINE_ENV=test

# AVEONLINE_GENERATE_REAL controla FACTURACIÓN (Lucy 2026-06-26 — doble gate seguro):
#   Sin setear / false (default): `bloquegenerarguia=1` → NO factura aunque genere
#     guía + PDF visible. Modo correcto para dev/preview/staging.
#   "true" + NODE_ENV=production: `bloquegenerarguia=0` → genera guía FACTURABLE
#     (cartera real en Aveonline). Setear SOLO cuando launch productivo confirmado.
# AVEONLINE_GENERATE_REAL=false
#
# AVEONLINE_FORCE_BILLING (escape hatch — dev avanzado):
#   "true" permite facturar real DESDE DEV (combinado con AVEONLINE_GENERATE_REAL=true).
#   Útil para una prueba E2E final pre-launch sin tener que deployear. PELIGROSO.
# AVEONLINE_FORCE_BILLING=false

# AVEONLINE_WEBHOOK_SECRET (Lucy 2026-05-25):
#   HMAC para validar webhook tracking entrante (/api/webhooks/aveonline?secret=X).
#   Generar con `openssl rand -hex 32`. Registrar en panel Aveonline al crear webhook.
AVEONLINE_WEBHOOK_SECRET=PLACEHOLDER

# AVEONLINE_ALLOW_QUERY_SECRET (transitorio — auditoría D-1): en "true" el webhook
# acepta el secreto por ?secret= en la URL ADEMÁS del header/payload.token. Ese secreto
# queda en access logs de Vercel/CDN y en el Referer → default OFF (ausente o cualquier
# otro valor = rechazado). Encender SOLO si el webhook registrado en el panel de
# Aveonline aún lleva el secreto en la URL; al migrarlo a header/payload.token, apagar.
AVEONLINE_ALLOW_QUERY_SECRET=false

# ──────────────── Resend ────────────────
RESEND_API_KEY=re_PLACEHOLDER
EMAIL_FROM="Lucams_shop <onboarding@resend.dev>"
# EMAIL_FROM=Lucams_shop <hola@mail.lucamsshop.com>  # producción al verificar dominio
# Buzón real del dominio principal al que van las respuestas: el From vive en el subdominio de
# envío (mail.lucamsshop.com), que NO recibe correo. Sin esto, cada "Responder" del cliente se pierde.
EMAIL_REPLY_TO="hola@lucamsshop.com"

# Newsletter — opcional. Si se setea, los suscriptores se asocian al
# Segment indicado. Si no, quedan en el pool general del workspace.
# Resend migró de "Audiences" (legacy) a "Segments" — crear desde
# dashboard.resend.com → Segments → New segment.
# RESEND_NEWSLETTER_SEGMENT_ID=seg_xxxxxxxxxxxx

# ──────────────── Cloudflare Turnstile (CAPTCHA) ────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxx

# ──────────────── Cloudflare R2 (backups en producción) ────────────────
R2_ACCOUNT_ID=PLACEHOLDER
R2_ACCESS_KEY_ID=PLACEHOLDER
R2_SECRET_ACCESS_KEY=PLACEHOLDER
R2_BUCKET=lucams-backups

# Backup manual (`pnpm db:backup`) y DR drill — opcionales, con defaults sensatos:
# BACKUP_DATABASE_URL  override de la conexión DIRECTA para pg_dump (default DIRECT_URL).
#                      El workflow diario la inyecta desde secrets de GitHub.
# BACKUP_PREFIX=db     prefijo de las llaves en el bucket (default "db"; el mirror de
#                      Storage usa "<BACKUP_PREFIX>-storage").
# BACKUP_KEEP=8        retención local (default 8; el workflow diario fija 30 ≈ 1 mes).
# DRILL_DATABASE_URL   SOLO CI (dr-drill): Postgres scratch donde se restaura el dump.
# DRILL_MIN_PRODUCTS=5  piso detector de dumps vacíos (default 5; los conteos del drill
#                      cuadran EXACTOS contra las filas COPY del dump desde 2026-09-04 —
#                      el catálogo real son 11 productos desde la depuración 2026-08-10).

# Backup de Supabase Storage → R2 (F-16, auditoría 2026-09-04 — mirror diario cifrado,
# scripts/backup-storage-to-r2.mjs + job backup-storage de .github/workflows/backup.yml):
# BACKUP_SUPABASE_URL / BACKUP_SUPABASE_SECRET_KEY: URL y secret key (service) del proyecto
#   a respaldar. Prefijo BACKUP_ para NO mezclarlas con las del runtime de la app — en
#   GitHub Actions las inyecta el workflow desde Secrets. Para la corrida local manual
#   (`pnpm --filter web storage:backup`) el script cae a NEXT_PUBLIC_SUPABASE_URL /
#   SUPABASE_SECRET_KEY si las BACKUP_* faltan. La secret key bypassea RLS: jamás exponerla
#   como NEXT_PUBLIC_*.
# BACKUP_STORAGE_BUCKETS: buckets a respaldar, separados por coma
#   (default: customer-uploads,production-assets,design-previews,cms-media,product-images).
# BACKUP_GPG_PASSPHRASE: la MISMA passphrase gpg del backup de la DB (GitHub Secret; valor
#   en el gestor de Lucy). Fail-closed: sin ella el mirror no corre.
# DRILL_STORAGE_BUCKET: SOLO CI (dr-drill-storage.mjs) — fuerza qué bucket verificar
#   (default: el primero del manifiesto más nuevo con objetos > 0).

# ──────────────── CSRF ────────────────
# Generar con: openssl rand -hex 32
CSRF_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32

# Secreto compartido con los jobs de pg_cron (header x-cron-secret). OBLIGATORIO en producción:
# sin él la app no arranca (lib/env.ts PROD_REQUIRED) y las alertas/resumen diario no corren.
CRON_SECRET=genera-uno-largo-y-aleatorio

# Jobs pg_cron deshabilitados por ambiente (comma-separado; nombres de CRON_JOBS en
# features/observability/cron-heartbeat.ts). Un job listado acá NO cuenta como "overdue" en
# /api/health/crons ni dispara la alerta dead-man: evita el falso degraded eterno en ambientes
# donde el job está desagendado A PROPÓSITO.
# En stg vale los 5 jobs de email (desagendados 2026-08-05 — docs/OPERATIONS.md «Jobs HTTP pg_cron»):
# CRON_JOBS_DISABLED=alerts,daily-summary,review-request,cart-recovery,back-in-stock
# En prd va vacía (todos los jobs agendados y monitoreados). En local vale los
# jobs diarios que corren de madrugada (el dev server suele estar apagado a esas
# horas y el dead-man los reportaría en ciclo):
# CRON_JOBS_DISABLED=daily-summary,review-request,purge-anon-designs,purge-event-logs

# ──────────────── Misc ────────────────
# Toggle de features flag-driven (cuando se necesiten)
# FEATURE_AI_DESIGN_SUGGEST=true

# Asistente IA de sugerencias de diseño (ADR-058) — proveedor Gemini (nivel gratuito para dev).
# La key es SERVER-ONLY (fetch servidor→Google). Sin ella, el asistente cae a "no disponible"
# (nunca rompe el editor). Fallback entre modelos: primario → respaldo.
GEMINI_API_KEY=PLACEHOLDER
GEMINI_MODEL_PRIMARY=gemini-2.5-flash-lite    # primario (barato / free-tier)
GEMINI_MODEL_FALLBACK=gemini-2.5-flash         # respaldo si el primario falla

# ──────────────── Proveedores (auditoría experto 2026-07-26: faltaban en el example) ────────────────
# Proveedor de pagos: "wompi" (hoy único soportado). Lo lee features/payments/provider.
PAYMENT_PROVIDER=wompi

# FACTURACIÓN Aveonline (doble gate de seguridad — leer features/shipping/aveonline.ts):
#   AVEONLINE_GENERATE_REAL=true  → genera guías REALES (visibles en el panel Aveonline).
#   AVEONLINE_FORCE_BILLING=true  → ADEMÁS factura (bloquegenerarguia=0). NUNCA en dev/preview.
# Sin setear / false (default recomendado): NO se genera guía real ni se factura.
AVEONLINE_GENERATE_REAL=false
AVEONLINE_FORCE_BILLING=false

# Mantenimiento: "1" muestra la página de mantenimiento a todo el sitio
# (proxy.ts compara === "1" — "true" NO lo activa).
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Versión de build pública (visible en el footer "v<sha>"). Se inyecta en CI/deploy.
NEXT_PUBLIC_BUILD_VERSION=dev
NEXT_PUBLIC_GIT_SHA=dev

# Resend — webhook (Svix) para bajas/rebotes reales (ver app/api/webhooks/resend/route.ts).
# Se genera en el dashboard de Resend → Webhooks → Signing secret (whsec_...).
RESEND_WEBHOOK_SECRET=PLACEHOLDER
# Segmento de audiencia de Resend para la newsletter (id del segmento en el dashboard).
RESEND_NEWSLETTER_SEGMENT_ID=PLACEHOLDER

# ──────────────── CI / smokes (no va en producción) ────────────────
# Bypass de la Deployment Protection de Vercel para los smokes del preview
# (tests/e2e/preview-cert.spec.ts y k6 con `-e VERCEL_BYPASS_TOKEN=...`; header
# x-vercel-protection-bypass). Vive en .env.stg; se genera en Vercel → Settings →
# Deployment Protection.
# VERCEL_BYPASS_TOKEN=PLACEHOLDER
