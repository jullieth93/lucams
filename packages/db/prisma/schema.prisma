// Schema Prisma — Lucams_shop
//
// Fuente de spec: docs/ARCHITECTURE.md § Modelo de datos +
// docs/CONVENTIONS.md § DB — soft delete + audit fields + § DB —
// foreign keys cascade explícito + ADR-014 (reserva stock) +
// ADR-016 (rate-limit Postgres).
//
// Convenciones aplicadas:
//   - id: cuid()
//   - Precios: Int (centavos COP) — nunca float (mandato CLAUDE.md).
//   - Audit fields en TODA entidad MUTABLE: createdAt, updatedAt,
//     createdBy, updatedBy, deletedAt, deletedBy.
//   - Append-only logs (InventoryLog, LoyaltyTxn, AdminActionLog,
//     WebhookEvent, Referral, StockReservation): solo createdAt.
//   - Soft delete: filtrar por `deletedAt IS NULL` en repositories.
//   - onDelete explícito en cada relación.
//
// Tablas NO-Prisma (creadas vía supabase/migrations/*.sql):
//   - rate_limit_buckets, cache_entries (ADR-016): bajo nivel, snake_case.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────── ENUMS ────────────────────────

enum AdminRole {
  SUPERADMIN
  MANAGER
  FULFILLMENT
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  WOMPI
  COD
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum WebhookSource {
  WOMPI
  VENNDELO
  RESEND
}

// Documento de identidad / tributario colombiano (DIAN factura electrónica).
enum DocumentType {
  CC // Cédula de ciudadanía
  CE // Cédula de extranjería
  NIT // NIT empresa
  PP // Pasaporte
  TI // Tarjeta de identidad
}

// Responsabilidad tributaria DIAN simplificada — se expande si hace falta.
enum TaxResponsibility {
  PERSONA_NATURAL_NO_RESPONSABLE
  PERSONA_NATURAL_RESPONSABLE
  PERSONA_JURIDICA
}

// Estado de la factura electrónica DIAN para el Order.
enum DianStatus {
  NOT_REQUIRED
  PENDING
  SENT
  ACCEPTED
  REJECTED
}

// Scope de consentimiento Ley 1581 colombiana — granular para que el
// banner de cookies + newsletter + habeas data registren cada toggle
// por separado con su versión, IP, UA, fecha.
enum ConsentScope {
  COOKIES_NECESSARY // siempre on
  COOKIES_FUNCTIONAL
  COOKIES_ANALYTICS
  COOKIES_MARKETING
  NEWSLETTER
  MARKETING_PROFILING // perfilamiento (segmentación, recomendaciones)
  HABEAS_DATA // autorización general tratamiento de datos personales
}

// ──────────────────────── CMS (sub-bloque J) ────────────────────────

// Formato del cuerpo de un bloque CMS. La mayoría son MARKDOWN.
// HTML solo para tablas complejas (cookies/subprocesadores) con
// rehype-sanitize allowlist. TEXT para strings cortos sin estructura.
// JSON para arrays estructurados (futuro: steps de un proceso).
enum BlockFormat {
  MARKDOWN
  HTML
  TEXT
  JSON
}

// Categoría del bloque CMS para agrupar en el admin + filtrar en RAG.
enum BlockCategory {
  LEGAL // 8 páginas /legal/*
  HOME // hero, secciones, CTAs home
  FOOTER // tagline, newsletter copy
  EMPTY_STATE // 404, errores, carrito vacío, sin resultados
  COOKIES // banner Ley 1581 (sub-bloque E)
  FAQ // entradas /ayuda (sub-bloque E)
  SUPPORT // /contacto, /mi-cuenta/pedidos textos (sub-bloque E)
  MAINTENANCE // /maintenance page (sub-bloque E)
  EMAIL // templates react-email (sub-bloque G)
  MARKETING // banners promocionales, hero rotativo futuro
}

// Tipo de valor para SiteSetting (validación admin form + display).
enum SettingType {
  TEXT
  EMAIL
  URL
  NUMBER
  PHONE // WA en formato wa.me (sin + ni espacios)
  COLOR // futuro: hex code
  BOOLEAN // futuro: feature flags
}

// Categoría de SiteSetting para agrupar en el admin.
enum SettingCategory {
  CONTACT // email, WhatsApp, redes
  BUSINESS // horarios, ubicación, NIT (futuro)
  LEGAL // versiones policies, plazos
  COMMERCE // mínimo orden, días fabricación, cobertura
  SOCIAL // Instagram, TikTok URLs (mantenido separado)
  EXTERNAL // DPA links, gov URLs
  WHATSAPP // mensajes pre-armados
  COPYRIGHT // año, tagline, location
  SEO // titles/descriptions defaults
}

// ──────────────────────── IDENTIDAD ────────────────────────

model Customer {
  id                String             @id @default(cuid())
  email             String             @unique
  phone             String?
  firstName         String?
  lastName          String?
  supabaseUserId    String             @unique
  // Datos tributarios DIAN — opcionales en perfil, obligatorios en
  // checkout cuando se emite factura electrónica (Fase 7).
  documentType      DocumentType?
  documentNumber    String? // nullable porque se completa en checkout
  taxResponsibility TaxResponsibility?
  loyaltyPoints     Int                @default(0)
  referralCode      String             @unique
  referredById      String?
  referredBy        Customer?          @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         Customer[]         @relation("Referrals")
  addresses         Address[]
  orders            Order[]
  reviews           Review[]
  loyaltyTxns       LoyaltyTxn[]
  consents          Consent[]
  supportTickets    SupportTicket[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([documentType, documentNumber])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  line1      String
  line2      String?
  city       String
  department String
  zip        String?
  phone      String
  isDefault  Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([customerId, deletedAt])
}

model AdminUser {
  id             String    @id @default(cuid())
  supabaseUserId String    @unique
  email          String    @unique
  role           AdminRole
  isActive       Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([role, isActive])
}

// ──────────────────────── CATÁLOGO ────────────────────────

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("Subcategories")
  products    Product[]
  order       Int        @default(0)
  isActive    Boolean    @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([parentId])
}

model Product {
  id                    String           @id @default(cuid())
  slug                  String           @unique
  name                  String
  description           String
  basePrice             Int
  compareAtPrice        Int?
  cost                  Int?
  sku                   String           @unique
  isPersonalizable      Boolean          @default(false)
  personalizationSchema Json?
  images                String[]
  categoryId            String
  category              Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants              ProductVariant[]
  reviews               Review[]
  isActive              Boolean          @default(true)
  isFeatured            Boolean          @default(false)
  seoTitle              String?
  seoDescription        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductVariant {
  id            String             @id @default(cuid())
  productId     String
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  sku           String             @unique
  price         Int?
  stock         Int                @default(0)
  attributes    Json
  inventoryLogs InventoryLog[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reservations  StockReservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([productId, deletedAt])
  @@index([stock])
}

model InventoryLog {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  delta     Int
  reason    String
  orderId   String?
  createdAt DateTime       @default(now())
  createdBy String?

  @@index([variantId, createdAt])
}

// ──────────────────────── CARRITO Y ÓRDENES ────────────────────────

model Cart {
  id         String         @id @default(cuid())
  customerId String?
  sessionId  String         @unique
  currency   String         @default("COP")
  items      CartItem[]
  abandoned  AbandonedCart?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([customerId, deletedAt])
}

model CartItem {
  id           String         @id @default(cuid())
  cartId       String
  cart         Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  qty          Int
  customDesign Json?
  unitPrice    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
}

model Order {
  id                    String        @id @default(cuid())
  number                String        @unique
  customerId            String?
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email                 String
  phone                 String
  shippingAddress       Json
  subtotal              Int
  discount              Int           @default(0)
  shipping              Int
  tax                   Int           @default(0)
  total                 Int
  currency              String        @default("COP")
  status                OrderStatus   @default(DRAFT)
  paymentMethod         PaymentMethod
  wompiTransactionId    String?
  venndeloShipmentId    String?
  trackingUrl           String?
  couponId              String?
  coupon                Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  notes                 String?
  items                 OrderItem[]
  // DIAN factura electrónica (Fase 7 implementa el envío; aquí el
  // schema queda ready para no remigrar después).
  billingDocumentType   DocumentType?
  billingDocumentNumber String?
  billingName           String?
  dianStatus            DianStatus    @default(NOT_REQUIRED)
  dianCufe              String? // CUFE devuelto por la DIAN
  dianXmlUrl            String? // URL del XML firmado

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([customerId, deletedAt])
  @@index([status, createdAt])
  @@index([wompiTransactionId])
  @@index([dianStatus])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  qty            Int
  unitPrice      Int
  customDesign   Json?
  designAssetUrl String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  value     Int
  minOrder  Int?
  maxUses   Int?
  usedCount Int        @default(0)
  validFrom DateTime
  validTo   DateTime
  isActive  Boolean    @default(true)
  orders    Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([code, isActive, deletedAt])
  @@index([validFrom, validTo])
}

// ──────────────────────── RESEÑAS ────────────────────────

model Review {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating     Int
  comment    String
  images     String[]
  // Datos del reseñador (snapshot al momento de la reseña — para
  // mostrar incluso si customer queda nullado por delete account).
  authorName String?
  authorCity String?
  isApproved Boolean   @default(false)
  // Marcar reseñas excepcionales para mostrar en la home + secciones
  // destacadas. Solo admin moderator setea featured=true.
  featured   Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([productId, isApproved, deletedAt])
  @@index([customerId])
  @@index([featured, isApproved])
}

// ──────────────────────── MARKETING / LOYALTY ────────────────────────

model AbandonedCart {
  id                 String    @id @default(cuid())
  cartId             String    @unique
  cart               Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  email              String
  lastReminderSentAt DateTime?
  recoveredAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recoveredAt, lastReminderSentAt])
}

model LoyaltyTxn {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  delta      Int
  reason     String
  orderId    String?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

model Referral {
  id            String    @id @default(cuid())
  referrerId    String
  referredEmail String
  status        String
  rewardedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([referrerId, status])
  @@index([referredEmail])
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  content        String
  coverImage     String?
  author         String
  publishedAt    DateTime?
  isPublished    Boolean   @default(false)
  seoTitle       String?
  seoDescription String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([isPublished, publishedAt])
  @@index([deletedAt])
}

// ──────────────────────── IDEMPOTENCIA / WEBHOOKS ────────────────────────

model WebhookEvent {
  id          String        @id @default(cuid())
  source      WebhookSource
  externalId  String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  @@unique([source, externalId])
  @@index([processedAt])
}

// ──────────────────────── RESERVA DE STOCK (ADR-014) ────────────────────────

model StockReservation {
  id        String         @id @default(cuid())
  orderId   String
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([expiresAt])
  @@index([orderId])
}

// ──────────────────────── AUDIT LOG ADMIN ────────────────────────

model AdminActionLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// ──────────────────────── CONSENTIMIENTO LEY 1581 ────────────────────────
// Registro granular de consentimiento del titular según Ley 1581.
// Cada toggle del banner cookies + newsletter + autorización general
// se persiste como una fila independiente con versión, IP, UA y fecha.
// Append-only: revocación crea nueva fila con accepted=false y
// `revokedAt` apuntando al toggle revocado.

model Consent {
  id         String       @id @default(cuid())
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Para guests/newsletter sin cuenta: identificamos por email.
  email      String?
  scope      ConsentScope
  accepted   Boolean
  // Versión del aviso de privacidad / términos que el titular vió
  // al consentir. Si cambia el aviso, requeríamos re-consentimiento.
  version    String
  ipAddress  String?
  userAgent  String?
  // Si revoca un consentimiento previo, apunta a su id.
  revokesId  String?
  revokes    Consent?     @relation("ConsentRevocations", fields: [revokesId], references: [id], onDelete: SetNull)
  revokedBy  Consent[]    @relation("ConsentRevocations")
  acceptedAt DateTime     @default(now())

  @@index([customerId, scope])
  @@index([email, scope])
  @@index([scope, acceptedAt])
}

// ──────────────────────── OBSERVABILIDAD ────────────────────────

// Reportes RUM (Real User Monitoring) — Web Vitals enviados desde
// `app/_vitals.tsx` con useReportWebVitals. Permite agregar por route
// y mostrar p50/p75/p95 en /admin/performance.

model WebVital {
  id        String   @id @default(cuid())
  name      String // "LCP" | "FID" | "CLS" | "INP" | "TTFB" | "FCP"
  value     Float
  rating    String // "good" | "needs-improvement" | "poor"
  delta     Float
  navType   String? // "navigate" | "reload" | "back-forward" | "prerender"
  route     String // path normalizado (e.g. "/producto/[slug]")
  sessionId String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([name, route, createdAt])
  @@index([route, createdAt])
}

// Eventos custom de funnel (add-to-cart, search, newsletter-signup,
// product-view) — alternativa propia a Google Analytics. Solo se
// escriben si el customer dió consentimiento ANALYTICS o MARKETING
// según el caso. Append-only.

model SiteEvent {
  id         String   @id @default(cuid())
  name       String // "cart.add" | "search.query" | "newsletter.signup" | "product.view" ...
  customerId String?
  sessionId  String?
  route      String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([customerId, createdAt])
  @@index([sessionId, createdAt])
}

// Reportes de error capturados client+server, deduplicados por
// fingerprint (SHA-1 de message + stack[:3]). Alternativa propia
// a Sentry (mandato CLAUDE.md sin Sentry hasta evaluar Fase 7).

model ErrorReport {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  message     String
  stack       String?
  url         String?
  userAgent   String?
  userId      String?
  digest      String?
  // count incrementa con cada ocurrencia del mismo fingerprint.
  count       Int       @default(1)
  status      String    @default("OPEN") // "OPEN" | "RESOLVED" | "IGNORED"
  metadata    Json      @default("{}")
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([status, lastSeenAt])
  @@index([fingerprint])
}

// Webhooks de Resend para tracking de email transaccional.
// Idempotente via WebhookEvent.unique([source, externalId]); aquí
// guardamos la versión normalizada por email destino para joins
// fáciles con Customer.

model EmailEvent {
  id         String   @id @default(cuid())
  resendId   String   @unique
  type       String // "email.sent" | "email.delivered" | "email.bounced" | "email.complained" | "email.opened" | "email.clicked"
  to         String
  fromEmail  String
  subject    String?
  metadata   Json     @default("{}")
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([to, occurredAt])
  @@index([type, occurredAt])
}

// ──────────────────────── SOPORTE ────────────────────────

model SupportTicket {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email      String
  name       String
  subject    String
  message    String
  status     String    @default("OPEN") // "OPEN" | "IN_PROGRESS" | "CLOSED"
  ip         String?
  userAgent  String?
  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@index([email])
}

// ──────────────────────── CMS BLOCKS ────────────────────────
// Contenido editable desde admin: prosa larga (legales, FAQ, hero copy,
// empty states). Versionado por save. Render via react-markdown en el
// storefront. Consumible por futuro chatbot RAG vía /api/cms/blocks.

model CmsBlock {
  id                 String            @id @default(cuid())
  key                String            @unique // "legal.privacidad", "home.hero.title"
  title              String? // Display interno en admin
  body               String // Cuerpo según `format` (markdown/html/text/json)
  format             BlockFormat       @default(MARKDOWN)
  category           BlockCategory
  description        String? // Notas para la editora: "Aparece en footer + /legal/*"
  metadata           Json              @default("{}")
  isPublished        Boolean           @default(false)
  publishedVersionId String? // Apunta a la versión actualmente publicada
  publishedVersion   CmsBlockVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           CmsBlockVersion[] @relation("BlockVersions")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([category, isPublished])
  @@index([key])
  @@index([deletedAt])
}

// Append-only: cada save crea una versión inmutable. Permite ver
// historial + revertir + cumplir auditoría legal de qué decía el
// aviso de privacidad un día específico.
model CmsBlockVersion {
  id           String      @id @default(cuid())
  blockId      String
  block        CmsBlock    @relation("BlockVersions", fields: [blockId], references: [id], onDelete: Cascade)
  version      Int // Auto-increment por blockId (1, 2, 3...)
  title        String?
  body         String
  format       BlockFormat
  metadata     Json        @default("{}")
  publishedAt  DateTime? // null = borrador
  publishedFor CmsBlock[]  @relation("PublishedVersion")

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([blockId, version])
  @@index([blockId, createdAt])
}

// ──────────────────────── SITE SETTINGS ────────────────────────
// Configurables atómicos (email, horario, número WA, plazos legales,
// versiones policies, URLs DPA, mensajes WhatsApp). NO versionado —
// AdminActionLog captura quién cambió qué cuándo.

model SiteSetting {
  id          String          @id @default(cuid())
  key         String          @unique // "CONTACT_EMAIL", "BUSINESS_HOURS"
  value       String
  valueType   SettingType     @default(TEXT)
  label       String // Display admin: "Email de contacto público"
  description String? // "Aparece en footer + /contacto + /legal/*"
  category    SettingCategory

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([category])
}
