// Schema Prisma — Lucams_shop
//
// Fuente de spec: docs/ARCHITECTURE.md § Modelo de datos +
// docs/CONVENTIONS.md § DB — soft delete + audit fields + § DB —
// foreign keys cascade explícito + ADR-014 (reserva stock) +
// ADR-016 (rate-limit Postgres).
//
// Convenciones aplicadas:
//   - id: cuid()
//   - Precios: Int (centavos COP) — nunca float (mandato CLAUDE.md).
//   - Audit fields en TODA entidad MUTABLE: createdAt, updatedAt,
//     createdBy, updatedBy, deletedAt, deletedBy.
//   - Append-only logs (InventoryLog, LoyaltyTxn, AdminActionLog,
//     WebhookEvent, Referral, StockReservation): solo createdAt.
//   - Soft delete: filtrar por `deletedAt IS NULL` en repositories.
//   - onDelete explícito en cada relación.
//
// Tablas NO-Prisma (creadas vía supabase/migrations/*.sql):
//   - rate_limit_buckets, cache_entries (ADR-016): bajo nivel, snake_case.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────── ENUMS ────────────────────────

enum AdminRole {
  SUPERADMIN
  MANAGER
  FULFILLMENT
  CMS_EDITOR // puede editar contenido del sitio, nada más
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  WOMPI
  COD
}

// ADR-064 — Conciliación del efectivo contraentrega (COD). El courier cobra el efectivo al entregar
// y luego lo remite a la tienda; Aveonline no expone datos de liquidación, así que Lucy concilia a
// mano cuando ve el depósito. El estado "por remitir" NO se guarda: se DERIVA de las órdenes COD
// DELIVERED sin entrada REMITTED. Solo se persisten las RESOLUCIONES.
enum CodReconciliationStatus {
  REMITTED // el courier ya remitió el efectivo a la tienda → conciliado ✓
  DISCREPANCY // el efectivo recibido no cuadra o no llegó → requiere atención
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum WebhookSource {
  WOMPI
  RESEND
  AVEONLINE
}

// Documento de identidad / tributario colombiano (DIAN factura electrónica).
enum DocumentType {
  CC // Cédula de ciudadanía
  CE // Cédula de extranjería
  NIT // NIT empresa
  PP // Pasaporte
  TI // Tarjeta de identidad
}

// Responsabilidad tributaria DIAN simplificada — se expande si hace falta.
enum TaxResponsibility {
  PERSONA_NATURAL_NO_RESPONSABLE
  PERSONA_NATURAL_RESPONSABLE
  PERSONA_JURIDICA
}

// Estado de la factura electrónica DIAN para el Order.
enum DianStatus {
  NOT_REQUIRED
  PENDING
  SENT
  ACCEPTED
  REJECTED
}

// Scope de consentimiento Ley 1581 colombiana — granular para que el
// banner de cookies + newsletter + habeas data registren cada toggle
// por separado con su versión, IP, UA, fecha.
enum ConsentScope {
  COOKIES_NECESSARY // siempre on
  COOKIES_FUNCTIONAL
  COOKIES_ANALYTICS
  COOKIES_MARKETING
  NEWSLETTER
  BACK_IN_STOCK // "avísame cuando vuelva" — notificación transaccional pedida por el titular (#9)
  MARKETING_PROFILING // perfilamiento (segmentación, recomendaciones)
  HABEAS_DATA // autorización general tratamiento de datos personales
}

// ──────────────────────── CMS (sub-bloque J) ────────────────────────

// Formato del cuerpo de un bloque CMS. La mayoría son MARKDOWN.
// HTML solo para tablas complejas (cookies/subprocesadores) con
// rehype-sanitize allowlist. TEXT para strings cortos sin estructura.
// JSON para arrays estructurados (futuro: steps de un proceso).
enum BlockFormat {
  MARKDOWN
  HTML
  TEXT
  JSON
}

// Categoría del bloque CMS para agrupar en el admin + filtrar en RAG.
enum BlockCategory {
  LEGAL // 8 páginas /legal/*
  HOME // hero, secciones, CTAs home
  FOOTER // tagline, newsletter copy
  EMPTY_STATE // 404, errores, carrito vacío, sin resultados
  COOKIES // banner Ley 1581 (sub-bloque E)
  FAQ // entradas /ayuda (sub-bloque E)
  SUPPORT // /contacto, /mi-cuenta/pedidos textos (sub-bloque E)
  MAINTENANCE // /maintenance page (sub-bloque E)
  EMAIL // templates react-email (sub-bloque G)
  MARKETING // banners promocionales, hero rotativo futuro
}

// Tipo de valor para SiteSetting (validación admin form + display).
enum SettingType {
  TEXT
  EMAIL
  URL
  NUMBER
  PHONE // WA en formato wa.me (sin + ni espacios)
  COLOR // futuro: hex code
  BOOLEAN // futuro: feature flags
}

// Categoría de SiteSetting para agrupar en el admin.
enum SettingCategory {
  CONTACT // email, WhatsApp, redes
  BUSINESS // horarios, ubicación, NIT (futuro)
  LEGAL // versiones policies, plazos
  COMMERCE // mínimo orden, días fabricación, cobertura
  SOCIAL // Instagram, TikTok URLs (mantenido separado)
  EXTERNAL // DPA links, gov URLs
  WHATSAPP // mensajes pre-armados
  COPYRIGHT // año, tagline, location
  SEO // titles/descriptions defaults
}

// ──────────────────────── IDENTIDAD ────────────────────────

model Customer {
  id                 String                    @id @default(cuid())
  email              String                    @unique
  phone              String?
  firstName          String?
  lastName           String?
  supabaseUserId     String                    @unique
  // Datos tributarios DIAN — opcionales en perfil, obligatorios en
  // checkout cuando se emite factura electrónica (Fase 7).
  documentType       DocumentType?
  documentNumber     String? // nullable porque se completa en checkout
  taxResponsibility  TaxResponsibility?
  loyaltyPoints      Int                       @default(0)
  referralCode       String                    @unique
  referredById       String?
  referredBy         Customer?                 @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          Customer[]                @relation("Referrals")
  addresses          Address[]
  orders             Order[]
  reviews            Review[]
  loyaltyTxns        LoyaltyTxn[]
  consents           Consent[]
  supportTickets     SupportTicket[]
  warrantyClaims     WarrantyClaim[]
  // Sub-bloque M — Estudio de Personalización (diferenciador #1)
  designs            Design[]
  designAssets       DesignAsset[]
  wishlist           WishlistItem[]
  backInStockSubs    BackInStockSubscription[]
  // PLAN_CATALOG_V2 3.9 — tracking de cupones usados.
  couponUsages       CouponUsage[]
  // PLAN_CATALOG_V2 6.10 — logs de recomendaciones consumidas (CTR + conversión).
  recommendationLogs RecommendationLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([documentType, documentNumber])
  @@index([referredById])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  // Campos "display" derivados para la lista (line1 = calle legible compuesta,
  // city/department = nombres). La FUENTE DE VERDAD reusable es `structured`.
  line1      String
  line2      String?
  city       String
  department String
  zip        String?
  phone      String
  isDefault  Boolean  @default(false)
  // structured: la dirección en el MISMO formato estructurado del checkout
  // (deptCode, cityCode, kind urban|rural, vía/cruce/detalle | vereda/finca/ref,
  // zip). Permite reusar una dirección guardada al 100% en el checkout. Null en
  // direcciones legacy (creadas con el form plano) → reuso parcial (depto/ciudad).
  structured Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([customerId, deletedAt])
}

model AdminUser {
  id             String    @id @default(cuid())
  supabaseUserId String    @unique
  email          String    @unique
  role           AdminRole
  isActive       Boolean   @default(true)

  recoveryCodes AdminRecoveryCode[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([role, isActive])
}

// Códigos de respaldo de MFA (Lucy 2026-06-27). Supabase no provee recovery
// codes nativos para TOTP, así que los gestionamos acá: se guarda solo el HASH
// (sha256); el código en claro se muestra UNA vez al generarlo. Al usarse en el
// login, se marca usedAt y se desactiva el factor TOTP (acceso de emergencia).
model AdminRecoveryCode {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId, usedAt])
}

// ──────────────────────── CATÁLOGO ────────────────────────

model Category {
  id                  String     @id @default(cuid())
  slug                String     @unique
  name                String
  description         String?
  // PLAN_CATALOG_V2 2.10 — descripción rica semántica (markdown 200-400 palabras)
  // que alimenta al bot AI Fase 5+ y al render PDP. Lucy edita desde /admin/categorias.
  richDescription     String?    @db.Text
  // PLAN_CATALOG_V2 2.10 — casos de uso típicos en 2-3 frases.
  useCase             String?
  image               String?
  // Roadmap B3 — visual de la categoría (icono + gradiente del home grid y el
  // mega-menú). Decisión de dominio: es DATO DE CATÁLOGO (cómo se ve una
  // categoría del catálogo), NO contenido editorial → vive acá y se edita en
  // /admin/categorias; NO va en el CMS. Antes estaba quemado por slug en
  // código (category-grid.tsx / shop-mega-menu.tsx) y una categoría nueva no
  // podía tener icono sin deploy.
  //   - icon: nombre del icono lucide en PascalCase (ej. "PartyPopper").
  //     Se resuelve contra el subset curado CATEGORY_ICONS de
  //     apps/web/lib/category-visuals.ts (sin import dinámico inseguro).
  //   - gradient: clases tailwind del gradiente (ej. "from-brand-pink/30
  //     via-brand-coral/20 to-brand-purple/15").
  // Null en ambos = el storefront cae al mapa fallback por slug y luego al
  // default genérico (ver resolveCategoryIcon / resolveCategoryGradient).
  icon                String?
  gradient            String?
  // PLAN_CATALOG_V2 7.6 — keys de filtros visibles en esta categoría.
  // Vacío = todos los filtros aplican (default 7.2). No vacío = override manual.
  visibleFilters      String[]   @default([])
  // PLAN_CATALOG_V2 7.10 — orden default del grid.
  // "recent" | "price_asc" | "price_desc" | "most_purchased" | "featured"
  defaultSort         String?    @default("recent")
  // PLAN_CATALOG_V2 6.9 — slug del producto destacado manualmente (boost grid + scoring).
  featuredProductSlug String?
  // PLAN_CATALOG_V2 2.9 — activación programada (sub-cats estacionales).
  // Null = sin restricción de fecha.
  activeFrom          DateTime?
  activeUntil         DateTime?
  parentId            String?
  parent              Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: Restrict)
  children            Category[] @relation("Subcategories")
  products            Product[]
  order               Int        @default(0)
  isActive            Boolean    @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([parentId])
  @@index([isActive, parentId, order])
}

model Product {
  id                    String                    @id @default(cuid())
  slug                  String                    @unique
  name                  String
  description           String
  basePrice             Int
  compareAtPrice        Int?
  cost                  Int?
  sku                   String                    @unique
  // Personalización (sub-bloque M)
  // - isPersonalizable: flag legacy. NONE = no personalizable. Mantenido por
  //   compat hasta migrar consumers a personalizationKind != NONE.
  // - personalizationKind: enum tipado fuerte. Define el tipo de experiencia
  //   de personalización (PHOTO_PACK, CALENDAR_PHOTO_MONTH, EVENT_FAVOR...).
  // - personalizationSchema: metadata específica por kind (ej. photoSlots:6,
  //   aspectRatio:"1:1", allowText:true) — JSON validado en runtime con Zod.
  isPersonalizable      Boolean                   @default(false)
  personalizationKind   PersonalizationKind       @default(NONE)
  personalizationSchema Json?
  // PLAN_CATALOG_V2 2.10 — descripción rica semántica (markdown 300-800 palabras)
  // que el bot AI Fase 5+ usa como contexto y PDP renderea como ficha extendida.
  richDescription       String?                   @db.Text
  // PLAN_CATALOG_V2 2.10 — "¿por qué elegir este producto?" bullets cortos.
  whyChooseThis         String?                   @db.Text
  // PLAN_CATALOG_V2 2.10 — array de escenarios ideales ("regalo aniversario novia",
  // "decoración cuarto adolescente"). Bot lo usa para matchear consultas.
  idealFor              Json                      @default("[]")
  // PLAN_CATALOG_V2 4.1 — especificaciones físicas tipadas (Zod validado runtime).
  // Shape: { material, thicknessMm, magnetType, weightGrams, packaging, includes[],
  //          careInstructions?, countryOfOrigin: "CO" }
  physicalSpecs         Json?
  // PLAN_CATALOG_V2 4.2 — garantía legal Ley 1480 art. 11 (default 12 meses mínimo).
  warrantyMonths        Int                       @default(12)
  // PLAN_CATALOG_V2 4.2 — días hábiles de producción. Default 3.
  // Productos kind=NONE (Coleccionables) deberían tener productionDays=1 (stock ready).
  productionDays        Int                       @default(3)
  // PLAN_CATALOG_V2 4.2 — días hábiles de envío (rango min-max según destino Aveonline).
  shippingDaysMin       Int                       @default(2)
  shippingDaysMax       Int                       @default(5)
  // PLAN_CATALOG_V2 3.3 — mínimo unidades por línea de cart.
  // Ej. Recuerdos Matrimonio min 30 invitados.
  minimumQuantity       Int                       @default(1)
  // PLAN_CATALOG_V2 3.3 — máximo opcional (null = sin tope).
  maximumQuantity       Int?
  // PLAN_CATALOG_V2 5.5 — upcharge porcentual aplicado cuando el cliente elige
  // un template PREMADE (vs Camino 2 personalizable). Default 0% = mismo precio.
  // Excepción: Universos pueden tener 10-15% por diseño curado premium.
  premadeSurcharge      Int                       @default(0)
  images                String[]
  categoryId            String
  category              Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants              ProductVariant[]
  reviews               Review[]
  wishlistedBy          WishlistItem[]
  backInStockSubs       BackInStockSubscription[]
  designs               Design[]
  templates             PersonalizationTemplate[]
  quoteItems            QuoteItem[]
  // Ola Admin 100% — niveles de precio mayorista B2B por producto (/admin/mayorista).
  wholesaleTiers        WholesaleTier[]
  // PLAN_CATALOG_V2 1.5 / 2.10 — tags transversales por ocasión (matrimonio, día madre, etc.).
  ocasionTags           ProductOcasionTag[]
  isActive              Boolean                   @default(true)
  isFeatured            Boolean                   @default(false)
  seoTitle              String?
  seoDescription        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([personalizationKind, isActive])
}

model ProductVariant {
  id             String             @id @default(cuid())
  productId      String
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  // PLAN_CATALOG_V2 2.10 — "¿por qué elegir esta variante vs otra?".
  // Bot AI lo usa para sugerir variant correcto. Ej: "Set 12 ideal para baby shower
  // con muchos invitados; Set 4 perfecto si solo querés un detalle simbólico".
  description    String?
  sku            String             @unique
  price          Int?
  // Lucy 2026-06-27: "precio tachado" (promoción) POR OPCIÓN. Antes vivía en
  // Product.compareAtPrice, pero el precio real es por opción → el descuento
  // podía salir negativo en la tienda. Centavos COP. Null = sin promo.
  compareAtPrice Int?
  stock          Int                @default(0)
  // D1 (Lucy 2026-06-27): fotos propias de la opción. Vacío = hereda
  // Product.images (espeja la herencia de `price`). El PDP cambia la galería
  // al elegir la opción; el admin las sube desde el editor de la opción.
  images         String[]           @default([])
  attributes     Json
  inventoryLogs  InventoryLog[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  quoteItems     QuoteItem[]
  reservations   StockReservation[]
  isActive       Boolean            @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([productId, deletedAt])
  @@index([stock])
  @@index([productId, isActive])
}

model InventoryLog {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  delta     Int
  reason    String
  orderId   String?
  createdAt DateTime       @default(now())
  createdBy String?
  // NOTA: existe un UNIQUE INDEX PARCIAL que Prisma no puede expresar (índices
  // condicionales con WHERE no son soportados por @@unique). Vive en la migración
  // 20260626224910_fix_inventory_log_unique_per_variant:
  //   UNIQUE (orderId, reason, variantId)
  //     WHERE reason IN ('ORDER_PAID','ORDER_CANCELLED','ORDER_REFUNDED')
  // Garantiza idempotencia física del ledger (no se decrementa/revierte el mismo
  // variant 2x para el mismo order+reason) permitiendo múltiples variants por orden.
  // Si tocás este modelo, NO regeneres una migración que dropee este índice parcial.

  @@index([variantId, createdAt])
}

// ──────────────────────── CARRITO Y ÓRDENES ────────────────────────

model Cart {
  id         String         @id @default(cuid())
  customerId String?
  sessionId  String         @unique
  currency   String         @default("COP")
  items      CartItem[]
  abandoned  AbandonedCart?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([customerId, deletedAt])
}

model CartItem {
  id           String                   @id @default(cuid())
  cartId       String
  cart         Cart                     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  qty          Int
  unitPrice    Int
  // Personalización (sub-bloque M)
  // - designId: si el producto requiere personalización, apunta al Design
  //   draft/ready del cliente. NULL para productos NONE.
  // - customDesign: campo legacy mantenido para compat retroactiva con
  //   carritos pre-M. Nuevos carts usan designId. Deprecate en V2.
  designId     String?
  design       Design?                  @relation(fields: [designId], references: [id], onDelete: SetNull)
  customDesign Json?
  // PLAN_CATALOG_V2 5.3 — diseño PREMADE elegido en PDP (flujo prediseñado puro).
  // Cliente elige uno de los N diseños del producto Coleccionables/Separadores
  // sin pasar por estudio. Se valida que template.mode = PREMADE.
  // NULL para productos personalizables (que usan designId) o producto sin templates.
  templateId   String?
  template     PersonalizationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // PLAN_CATALOG_V2 — metadata flexible (futuro: gift wrap, notas especiales, etc.).
  metadata     Json                     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([variantId])
  @@index([designId])
  @@index([templateId])
}

model Order {
  id                      String             @id @default(cuid())
  number                  String             @unique
  customerId              String?
  customer                Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email                   String
  phone                   String
  shippingAddress         Json
  // Anti-abuso COD (ADR-065): clave normalizada de la dirección (depto|ciudad|línea|zip, sin tildes ni
  // no-alfanuméricos) para detectar velocidad por DIRECCIÓN aunque roten teléfono/email. La puebla
  // createOrderFromCart (shippingAddress es Json y no filtra eficiente). Null si faltan datos.
  shippingAddressKey      String?
  subtotal                Int
  discount                Int                @default(0)
  shipping                Int
  tax                     Int                @default(0)
  total                   Int
  currency                String             @default("COP")
  status                  OrderStatus        @default(DRAFT)
  paymentMethod           PaymentMethod
  wompiTransactionId      String?
  // #6 (certificación Bloque A 2026-06-26) — caso patológico: Wompi cobró pero
  // el stock se agotó entre PENDING_PAYMENT y PAID (carrera sobre última unidad).
  // La orden queda PENDING_PAYMENT y se marca acá para que sea VISIBLE en
  // /admin/pedidos (filtro "Necesitan atención") en vez de morir en un log que
  // nadie ve (mandato #7 sin Sentry). ACCIÓN HUMANA: refund o producir stock.
  needsReconciliation     Boolean            @default(false)
  reconciliationReason    String?
  // Anti-abuso COD (ADR-065): el admin marca un pedido como NO RECIBIDO (no-show) — señal explícita de
  // abuso, distinta del RETURNED del courier. Alimenta assessCodRisk para vetar futuros COD de la identidad.
  noShowAt                DateTime?
  noShowBy                String?
  // Bloque F2 — auditoría del reembolso desde admin. El movimiento de dinero en
  // Wompi es MANUAL (contraentrega + preferencia de operar la pasarela a mano);
  // estos campos registran quién marcó la orden REFUNDED, cuándo, por qué y el
  // monto (= total para reembolso completo). refundedBy = AdminUser.id.
  refundedAt              DateTime?
  refundedBy              String?
  refundReason            String?
  refundAmount            Int?
  // #2 (post-launch Bloque A) — timestamp de envío del email de confirmación.
  // Hace el envío idempotente Y recuperable: si la saga crashea entre el commit
  // de PAID y el envío del email, un reintento de processPaidOrder lo manda
  // (confirmationSentAt sigue null) sin duplicar (se setea al enviar).
  confirmationSentAt      DateTime?
  // #11-P1 (verificación post-launch Bloque A) — claim atómico de creación de
  // guía. processPaidOrder hace un updateMany condicional (WHERE trackingNumber
  // null AND (shipmentClaimedAt null OR stale)) ANTES de llamar a Aveonline:
  // solo un proceso concurrente gana el claim, el resto se saltea → imposible
  // crear 2 guías para la misma orden ya-PAID-sin-tracking. Se libera en fallo
  // y se re-clama si quedó stale (proceso crasheado) tras 10 min.
  shipmentClaimedAt       DateTime?
  // Bloque F3 — fecha de entrega efectiva (webhook Aveonline DELIVERED). Ancla la
  // ventana de 5 días hábiles del derecho de retracto (Ley 1480 art. 47).
  deliveredAt             DateTime?
  // Palanca de reseñas (auditoría 2026-07-13): timestamp del email de solicitud de reseña
  // (post-entrega, demorado). Null = aún no enviado → el cron lo considera elegible.
  reviewRequestedAt       DateTime?
  // Consentimiento de derechos de imagen (ADR-062 P0-2, Ley 1581). Al confirmar el pedido el
  // cliente acepta las condiciones —que incluyen declarar que tiene derecho a usar las imágenes
  // subidas y autorizar su impresión—. Se sella al crear la Order (baja fricción, sin checkbox
  // extra); es la evidencia con fecha del consentimiento.
  contentRightsAcceptedAt DateTime?
  // PLAN_CATALOG_V2 4.10 — Aveonline + ShippingProvider interface (ADR-039).
  // shippingCarrier: qué carrier eligió el cliente ("envia", "tcc", "coordinadora", etc.).
  shippingCarrier         String?
  // PLAN_CATALOG_V2 4.10 — número de guía del carrier.
  trackingNumber          String?
  trackingUrl             String?
  // PLAN_CATALOG_V2 4.10 — URL de impresión etiqueta (rutaimpresion en Aveonline).
  labelUrl                String?
  couponId                String?
  coupon                  Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  // PLAN_CATALOG_V2 3.9 — tracking del uso de cupón (incluye monto descontado).
  couponUsage             CouponUsage?
  // ADR-064 — conciliación del efectivo contraentrega (0..1 por orden; solo existe al resolver).
  codReconciliation       CodReconciliation?
  notes                   String?
  items                   OrderItem[]
  // DIAN factura electrónica (Fase 7 implementa el envío; aquí el
  // schema queda ready para no remigrar después).
  billingDocumentType     DocumentType?
  billingDocumentNumber   String?
  billingName             String?
  dianStatus              DianStatus         @default(NOT_REQUIRED)
  dianCufe                String? // CUFE devuelto por la DIAN
  dianXmlUrl              String? // URL del XML firmado
  // Token único para vista pública /pedido/[token] — guest checkout sin
  // cuenta accede a su pedido sin login con este link (Lucy 2026-05-22).
  // 32 chars hex generados con crypto.randomBytes(16).toString("hex").
  publicAccessToken       String?            @unique

  // P0-020 (Lucy 2026-06-26) — Cart de origen para idempotency cart→order.
  // NO FK (el Cart se soft-deletea al transicionar a PAID; la referencia
  // debe sobrevivir). Lookup como string nullable para Orders pre-existentes.
  // Permite que createOrderFromCart sea idempotente: si un cart ya tiene
  // Order PENDING_PAYMENT activa, retornamos esa en vez de crear otra.
  cartId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([customerId, deletedAt])
  @@index([status, createdAt])
  @@index([wompiTransactionId])
  @@index([dianStatus])
  @@index([trackingNumber])
  @@index([cartId, status])
  @@index([couponId])
  @@index([needsReconciliation])
  @@index([shippingAddressKey])
}

// Anti-abuso COD (ADR-065): lista de bloqueo persistente. Lucy puede vetar a mano un teléfono, email o
// dirección (clave normalizada) que abusó del contraentrega. assessCodRisk lo consulta (fail-open) y
// bloquea el COD sin revelar la regla. Solo admin/service la tocan (RLS deny-by-default).
model BlockedIdentity {
  id        String              @id @default(cuid())
  kind      BlockedIdentityKind
  // Valor normalizado según el kind: phone tal cual, email en minúsculas, address = shippingAddressKey.
  value     String
  reason    String
  createdBy String // AdminUser.id que lo bloqueó
  createdAt DateTime            @default(now())

  @@unique([kind, value])
  @@index([kind, value])
}

enum BlockedIdentityKind {
  PHONE
  EMAIL
  ADDRESS
}

// ADR-064 — Ledger de conciliación del efectivo contraentrega (COD). UNA fila por orden, creada solo
// cuando Lucy RESUELVE la conciliación (marca remitido o discrepancia) desde /admin/finanzas. El
// estado "por remitir" no se guarda: se deriva de órdenes COD DELIVERED sin fila REMITTED. No hay
// integración con la saga (bajo riesgo) ni datos de liquidación de Aveonline (remesa = acto manual).
// Idempotente por orderId @unique. Dinero en centavos COP (nunca float). Solo admin/service la tocan
// (RLS deny-by-default vía el event trigger, sin políticas → invisible para anon).
model CodReconciliation {
  id                String                  @id @default(cuid())
  orderId           String                  @unique
  order             Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status            CodReconciliationStatus
  expectedAmount    Int // COP centavos — recaudo esperado (= Order.total al momento de conciliar)
  remittedAmount    Int? // COP centavos — efectivo que la tienda realmente recibió del courier
  remittedAt        DateTime? // cuándo se recibió/registró la remesa
  remittedBy        String? // AdminUser.id que registró la remesa (sin FK, patrón refundedBy)
  carrierRef        String? // referencia del depósito/liquidación del courier
  discrepancyReason String? // por qué no cuadra (si status = DISCREPANCY)
  note              String? // nota libre de la conciliación
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, updatedAt])
}

model OrderItem {
  id             String                   @id @default(cuid())
  orderId        String
  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  qty            Int
  unitPrice      Int
  // Personalización (sub-bloque M)
  // - designId: snapshot del Design en estado USED_IN_ORDER (immutable post-pago).
  //   Si el Design original se borra después, la order conserva customDesign +
  //   designAssetUrl como audit history.
  // - customDesign: copia JSON inmutable del Design.canvasData al confirmar el order.
  // - designAssetUrl: URL del PNG 300 DPI listo para impresión (Supabase Storage
  //   bucket production-assets).
  designId       String?
  design         Design?                  @relation(fields: [designId], references: [id], onDelete: SetNull)
  customDesign   Json?
  designAssetUrl String?
  // PLAN_CATALOG_V2 5.3 — snapshot del template PREMADE al confirmar order (immutable).
  templateId     String?
  template       PersonalizationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // PLAN_CATALOG_V2 — metadata flexible (futuro: gift wrap, notas, etc.).
  metadata       Json                     @default("{}")
  // Bloque F3 — solicitud de retracto (Ley 2439). 1:1 opcional por item.
  retractRequest RetractRequest?
  // Garantías (Ley 1480). Historial: un item puede tener varios reclamos en el tiempo.
  warrantyClaims WarrantyClaim[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
  @@index([designId])
  @@index([templateId])
}

model Coupon {
  id                    String        @id @default(cuid())
  code                  String        @unique
  type                  CouponType
  value                 Int
  minOrder              Int?
  maxUses               Int?
  usedCount             Int           @default(0)
  validFrom             DateTime
  validTo               DateTime
  isActive              Boolean       @default(true)
  // PLAN_CATALOG_V2 3.9 — restricción por categorías (array de slugs).
  // Vacío = todas las categorías. Ej. ["de-temporada"] solo aplica en De Temporada.
  appliesToCategories   String[]      @default([])
  // PLAN_CATALOG_V2 3.9 — restricción por productos específicos (array de slugs).
  // Vacío = todos los productos.
  appliesToProductSlugs String[]      @default([])
  // PLAN_CATALOG_V2 3.9 — máx usos por cliente. Null = ilimitado.
  // Ej. Welcome coupon: maxUsesPerCustomer=1.
  maxUsesPerCustomer    Int?
  // PLAN_CATALOG_V2 3.9 — visible en /api/coupons/public para bot.
  // Default false = código privado distribuido por canal externo.
  isPublic              Boolean       @default(false)
  // PLAN_CATALOG_V2 3.9 — texto público "10% off Día Madre, vence 12 mayo".
  description           String?
  // PLAN_CATALOG_V2 3.9 — mínimo unidades en cart. Ej. "Compra 6+ y 10% off".
  requiresMinQuantity   Int?
  orders                Order[]
  usages                CouponUsage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([code, isActive, deletedAt])
  @@index([validFrom, validTo])
  @@index([isPublic, isActive, deletedAt])
}

// PLAN_CATALOG_V2 3.9 — tracking por cliente de uso de cupones.
// Permite enforcement de maxUsesPerCustomer + métricas admin (top códigos,
// total descontado, clientes que usaron cupón).
model CouponUsage {
  id         String    @id @default(cuid())
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Email normalizado (lower+trim) del pedido. Ancla el tope maxUsesPerCustomer también para el
  // checkout de INVITADO (customerId null) y cierra la evasión logueado→invitado con el mismo
  // correo (#4). Se cuenta por (customerId OR email). Best-effort: evadible con correos distintos.
  email      String?
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  appliedAt  DateTime  @default(now())
  amount     Int // descuento aplicado en COP centavos

  @@index([customerId, couponId])
  @@index([couponId, email])
  @@index([couponId, appliedAt])
}

// ──────────────────────── RETRACTO (Ley 2439) ────────────────────────
// Bloque F3 — derecho de retracto (Ley 1480 art. 47 + Ley 2439/2024): 5 días
// hábiles desde la entrega para devolver productos NO personalizados; reembolso
// en máx. 15 días calendario. Ver docs/COMPLIANCE.md. La elegibilidad se calcula
// al vuelo (item de catálogo estándar sin customDesign, dentro de la ventana).

enum RetractStatus {
  PENDING // solicitado, pendiente de aprobar
  APPROVED // aprobado, esperando que el cliente devuelva el producto
  RECEIVED // producto recibido de vuelta
  REFUNDED // reembolso emitido (dinero Wompi manual)
  REJECTED // rechazado (no elegible / fuera de ventana)
}

model RetractRequest {
  id            String        @id @default(cuid())
  orderItemId   String        @unique
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  status        RetractStatus @default(PENDING)
  reason        String? // texto libre del cliente
  rejectionNote String? // motivo si REJECTED
  refundAmount  Int // línea del item al solicitar (COP centavos)
  refundMethod  String? // "WOMPI_VOID" | "BANK_TRANSFER" — al reembolsar
  requestedAt   DateTime      @default(now())
  approvedAt    DateTime?
  receivedAt    DateTime?
  refundedAt    DateTime?
  processedBy   String? // AdminUser.id que gestionó la solicitud

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, requestedAt])
}

// ──────────────────────── GARANTÍAS (Ley 1480 art. 7-15) ────────────────────────

enum WarrantyStatus {
  PENDING // solicitada, pendiente de revisión
  IN_REVIEW // en diagnóstico
  APPROVED // procede — pendiente de ejecutar el remedio
  RESOLVED // resuelta (reparación / cambio / devolución)
  REJECTED // no procede (fuera de garantía / mal uso)
}

// Reclamo de garantía legal sobre un item comprado. A diferencia del retracto:
//  - Ventana = Product.warrantyMonths (meses calendario) desde la entrega, no 5 días hábiles.
//  - Los productos PERSONALIZADOS sí tienen garantía legal (un imán defectuoso se cubre).
//  - Se permite historial (no @unique): un producto puede fallar más de una vez; el service
//    bloquea un nuevo reclamo si ya hay uno ACTIVO (no resuelto/rechazado) para ese item.
model WarrantyClaim {
  id             String         @id @default(cuid())
  orderItemId    String
  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status         WarrantyStatus @default(PENDING)
  description    String // qué falla — texto del cliente
  evidenceUrls   String[]       @default([]) // fotos del defecto (opcional)
  resolutionType String? // "REPAIR" | "REPLACE" | "REFUND" — remedio Ley 1480
  resolutionNote String? // nota del admin (resolución o rechazo)
  requestedAt    DateTime       @default(now())
  resolvedAt     DateTime?
  processedBy    String? // AdminUser.id que gestionó

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, requestedAt])
  @@index([orderItemId])
  @@index([customerId])
}

// ──────────────────────── RESEÑAS ────────────────────────

model Review {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating     Int
  comment    String
  images     String[]
  // Datos del reseñador (snapshot al momento de la reseña — para
  // mostrar incluso si customer queda nullado por delete account).
  authorName String?
  authorCity String?
  isApproved Boolean   @default(false)
  // Marcar reseñas excepcionales para mostrar en la home + secciones
  // destacadas. Solo admin moderator setea featured=true.
  featured   Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([productId, isApproved, deletedAt])
  @@index([customerId])
  @@index([featured, isApproved])
}

// ──────────────────────── MARKETING / LOYALTY ────────────────────────

model AbandonedCart {
  id                 String    @id @default(cuid())
  cartId             String    @unique
  cart               Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  email              String
  // Token del link de recuperación (email → restaura la sesión del carrito anónimo). Único.
  recoverToken       String?   @unique
  lastReminderSentAt DateTime?
  recoveredAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recoveredAt, lastReminderSentAt])
}

model LoyaltyTxn {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  delta      Int
  reason     String
  orderId    String?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

model Referral {
  id            String    @id @default(cuid())
  referrerId    String
  referredEmail String
  status        String
  rewardedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([referrerId, status])
  @@index([referredEmail])
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  content        String
  coverImage     String?
  author         String
  publishedAt    DateTime?
  isPublished    Boolean   @default(false)
  seoTitle       String?
  seoDescription String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([isPublished, publishedAt])
  @@index([deletedAt])
}

// ──────────────────────── IDEMPOTENCIA / WEBHOOKS ────────────────────────

model WebhookEvent {
  id          String        @id @default(cuid())
  source      WebhookSource
  externalId  String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  @@unique([source, externalId])
  @@index([processedAt])
}

// ──────────────────────── RESERVA DE STOCK (ADR-014) ────────────────────────

model StockReservation {
  id        String         @id @default(cuid())
  orderId   String
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([expiresAt])
  @@index([orderId])
  @@index([variantId])
}

// ──────────────────────── AUDIT LOG ADMIN ────────────────────────

model AdminActionLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// ──────────────────────── CONSENTIMIENTO LEY 1581 ────────────────────────
// Registro granular de consentimiento del titular según Ley 1581.
// Cada toggle del banner cookies + newsletter + autorización general
// se persiste como una fila independiente con versión, IP, UA y fecha.
// Append-only: revocación crea nueva fila con accepted=false y
// `revokedAt` apuntando al toggle revocado.

model Consent {
  id         String       @id @default(cuid())
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Para guests/newsletter sin cuenta: identificamos por email.
  email      String?
  // Anclaje alterno para titulares SIN email: la cotización por WhatsApp (Etapa 1) pide el móvil
  // y deja el email opcional, así que sin esto una autorización de un invitado quedaría huérfana
  // (imposible de encontrar ante una solicitud de habeas data por WhatsApp). Móvil normalizado
  // a 10 dígitos, igual que Quote.customerWhatsapp.
  phone      String?
  scope      ConsentScope
  accepted   Boolean
  // Versión del aviso de privacidad / términos que el titular vió
  // al consentir. Si cambia el aviso, requeríamos re-consentimiento.
  version    String
  ipAddress  String?
  userAgent  String?
  // Si revoca un consentimiento previo, apunta a su id.
  revokesId  String?
  revokes    Consent?     @relation("ConsentRevocations", fields: [revokesId], references: [id], onDelete: SetNull)
  revokedBy  Consent[]    @relation("ConsentRevocations")
  acceptedAt DateTime     @default(now())

  @@index([customerId, scope])
  @@index([email, scope])
  @@index([phone, scope])
  @@index([scope, acceptedAt])
}

// ──────────────────────── OBSERVABILIDAD ────────────────────────

// Reportes RUM (Real User Monitoring) — Web Vitals enviados desde
// `app/_vitals.tsx` con useReportWebVitals. Permite agregar por route
// y mostrar p50/p75/p95 en /admin/performance.

model WebVital {
  id        String   @id @default(cuid())
  name      String // "LCP" | "FID" | "CLS" | "INP" | "TTFB" | "FCP"
  value     Float
  rating    String // "good" | "needs-improvement" | "poor"
  delta     Float
  navType   String? // "navigate" | "reload" | "back-forward" | "prerender"
  route     String // path normalizado (e.g. "/producto/[slug]")
  sessionId String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([name, route, createdAt])
  @@index([route, createdAt])
}

// Bloque D — captura de errores del servidor en DB (sin Sentry, mandato #7).
// Alimentado por instrumentation.onRequestError (todos los errores no manejados
// de RSC/route handlers/server actions). Append-only. Es la fuente para el panel
// /admin/observability y (futuro) las alertas por email. `digest` agrupa el mismo
// error (Next lo asigna); permite contar ocurrencias de un mismo fallo.
model ErrorLog {
  id          String   @id @default(cuid())
  message     String
  digest      String? // id de agrupación de Next para el mismo error
  stack       String? // primeras líneas del stack (truncado)
  routePath   String? // ruta del archivo, e.g. /checkout/pago
  requestPath String? // path del request, e.g. /checkout/pago?x=1
  method      String? // GET | POST | …
  routeType   String? // render | route | action | proxy
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([digest, createdAt])
}

// Bloque D — dedup de alertas por email. Guarda cuándo se envió por última vez
// cada tipo de alerta (`key`) para no re-enviar la misma dentro de la ventana
// anti-spam (30 min). Ver features/observability/alerts.ts.
model AlertState {
  key        String   @id
  lastSentAt DateTime @default(now())
  lastDetail String?
  updatedAt  DateTime @updatedAt
}

// Eventos custom de funnel (add-to-cart, search, newsletter-signup,
// product-view) — alternativa propia a Google Analytics. Solo se
// escriben si el customer dió consentimiento ANALYTICS o MARKETING
// según el caso. Append-only.

model SiteEvent {
  id         String   @id @default(cuid())
  name       String // "cart.add" | "search.query" | "newsletter.signup" | "product.view" ...
  customerId String?
  sessionId  String?
  route      String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([customerId, createdAt])
  @@index([sessionId, createdAt])
}

// Reportes de error capturados client+server, deduplicados por
// fingerprint (SHA-1 de message + stack[:3]). Alternativa propia
// a Sentry (mandato CLAUDE.md sin Sentry hasta evaluar Fase 7).

model ErrorReport {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  message     String
  stack       String?
  url         String?
  userAgent   String?
  userId      String?
  digest      String?
  // count incrementa con cada ocurrencia del mismo fingerprint.
  count       Int       @default(1)
  status      String    @default("OPEN") // "OPEN" | "RESOLVED" | "IGNORED"
  metadata    Json      @default("{}")
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([status, lastSeenAt])
  @@index([fingerprint])
}

// Webhooks de Resend para tracking de email transaccional.
// Idempotente via WebhookEvent.unique([source, externalId]); aquí
// guardamos la versión normalizada por email destino para joins
// fáciles con Customer.

model EmailEvent {
  id         String   @id @default(cuid())
  resendId   String   @unique
  type       String // "email.sent" | "email.delivered" | "email.bounced" | "email.complained" | "email.opened" | "email.clicked"
  to         String
  fromEmail  String
  subject    String?
  metadata   Json     @default("{}")
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([to, occurredAt])
  @@index([type, occurredAt])
}

// ──────────────────────── SOPORTE ────────────────────────

model SupportTicket {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email      String
  name       String
  subject    String
  message    String
  status     String    @default("OPEN") // "OPEN" | "IN_PROGRESS" | "CLOSED"
  ip         String?
  userAgent  String?
  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@index([email])
}

// ──────────────────────── CMS BLOCKS ────────────────────────
// DEPRECATED (CMS v2): reemplazado por CmsPage/CmsSection/CmsField. Se conserva
// como respaldo de datos hasta verificar la migración en producción; luego drop.
// Contenido editable desde admin: prosa larga (legales, FAQ, hero copy,
// empty states). Versionado por save. Render via react-markdown en el
// storefront. Consumible por futuro chatbot RAG vía /api/cms/blocks.

model CmsBlock {
  id                 String            @id @default(cuid())
  key                String            @unique // "legal.privacidad", "home.hero.title"
  title              String? // Display interno en admin
  body               String // Cuerpo según `format` (markdown/html/text/json)
  format             BlockFormat       @default(MARKDOWN)
  category           BlockCategory
  description        String? // Notas para la editora: "Aparece en footer + /legal/*"
  metadata           Json              @default("{}")
  isPublished        Boolean           @default(false)
  publishedVersionId String? // Apunta a la versión actualmente publicada
  publishedVersion   CmsBlockVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           CmsBlockVersion[] @relation("BlockVersions")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([category, isPublished])
  @@index([key])
  @@index([deletedAt])
}

// Append-only: cada save crea una versión inmutable. Permite ver
// historial + revertir + cumplir auditoría legal de qué decía el
// aviso de privacidad un día específico.
model CmsBlockVersion {
  id           String      @id @default(cuid())
  blockId      String
  block        CmsBlock    @relation("BlockVersions", fields: [blockId], references: [id], onDelete: Cascade)
  version      Int // Auto-increment por blockId (1, 2, 3...)
  title        String?
  body         String
  format       BlockFormat
  metadata     Json        @default("{}")
  publishedAt  DateTime? // null = borrador
  publishedFor CmsBlock[]  @relation("PublishedVersion")

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([blockId, version])
  @@index([blockId, createdAt])
}

// ──────────────────────── SITE SETTINGS ────────────────────────
// DEPRECATED (CMS v2): reemplazado por CmsField (kind SETTING). Se conserva
// como respaldo de datos hasta verificar la migración en producción; luego drop.
// Configurables atómicos (email, horario, número WA, plazos legales,
// versiones policies, URLs DPA, mensajes WhatsApp). NO versionado —
// AdminActionLog captura quién cambió qué cuándo.

model SiteSetting {
  id          String          @id @default(cuid())
  key         String          @unique // "CONTACT_EMAIL", "BUSINESS_HOURS"
  value       String
  valueType   SettingType     @default(TEXT)
  label       String // Display admin: "Email de contacto público"
  description String? // "Aparece en footer + /contacto + /legal/*"
  category    SettingCategory

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([category])
}

// ──────────────────────── CMS V2 — PÁGINA → SECCIÓN → CAMPO ────────────────────────
// Modelo relacional de contenido pensado para una administradora NO técnica:
// el contenido se navega por PÁGINA del sitio (Inicio, Footer, Contacto…) y
// dentro de cada página por SECCIÓN (Hero, Redes sociales…). Unifica los dos
// conceptos anteriores (CmsBlock + SiteSetting, DEPRECATED) en un solo CmsField:
//   - kind BLOCK   → prosa larga versionada (lo que era CmsBlock)
//   - kind SETTING → valor atómico (lo que era SiteSetting)
// Compatibilidad: CmsField.key conserva las mismas keys históricas
// ("home.hero.title", "CONTACT_EMAIL") → lib/cms.ts mantiene su API pública.
// CmsBlock/CmsBlockVersion/SiteSetting se conservan como respaldo hasta
// verificar la migración en producción; luego se dropean (ver HANDOFF).

// Tipo de campo CMS (validación del formulario admin + control de input).
// Unión de BlockFormat (MARKDOWN/HTML/TEXT/JSON) + SettingType
// (EMAIL/URL/NUMBER/PHONE/COLOR/BOOLEAN) + TEXTAREA para textos largos sin md.
enum CmsFieldType {
  TEXT
  TEXTAREA
  MARKDOWN
  HTML
  JSON
  EMAIL
  URL
  NUMBER
  PHONE // WA en formato wa.me (sin + ni espacios)
  COLOR
  BOOLEAN
  IMAGE // body = CmsMedia.id (roadmap B5); lectura pública vía getCmsImage
}

// Procedencia semántica del campo: BLOCK = prosa versionada con publicación
// explícita; SETTING = valor atómico (el admin publica al guardar).
enum CmsFieldKind {
  BLOCK
  SETTING
}

model CmsPage {
  id          String       @id @default(cuid())
  slug        String       @unique // "inicio", "footer", "contacto", "global"
  title       String // "Página principal" — display admin
  description String? // Qué cubre la página, para la administradora
  path        String? // Ruta pública para el botón "Ver página" ("/", "/contacto")
  icon        String? // Nombre de icono lucide para el índice admin
  sortOrder   Int          @default(0)
  sections    CmsSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model CmsSection {
  id          String     @id @default(cuid())
  pageId      String
  page        CmsPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key         String // "hero", "redes-sociales" (única por página)
  title       String // "Portada (hero)" — display admin
  description String?
  sortOrder   Int        @default(0)
  fields      CmsField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, key])
  @@index([pageId, sortOrder])
}

model CmsField {
  id                 String            @id @default(cuid())
  sectionId          String
  section            CmsSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  key                String            @unique // "home.hero.title", "CONTACT_EMAIL" (keys históricas)
  kind               CmsFieldKind
  label              String // "Título principal" — display admin no-técnico
  helpText           String? // "Aparece en la portada, máx ~60 caracteres"
  type               CmsFieldType      @default(TEXT)
  body               String // Borrador actual (mismo patrón que CmsBlock.body)
  metadata           Json              @default("{}")
  category           String // BlockCategory o SettingCategory legacy (API pública/RAG//ayuda)
  sortOrder          Int               @default(0)
  isPublished        Boolean           @default(false)
  publishedVersionId String?
  publishedVersion   CmsFieldVersion?  @relation("PublishedFieldVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           CmsFieldVersion[] @relation("FieldVersions")
  items              CmsListItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([sectionId, sortOrder])
  @@index([kind, category, isPublished])
  @@index([key])
  @@index([deletedAt])
}

// Append-only, espejo de CmsBlockVersion: historial inmutable + revert +
// auditoría legal de qué decía un texto un día específico. Para kind SETTING
// cada guardado crea versión publicada (el setting viejo no versionaba; esto
// es una mejora — AdminActionLog sigue capturando quién/cuándo).
model CmsFieldVersion {
  id           String     @id @default(cuid())
  fieldId      String
  field        CmsField   @relation("FieldVersions", fields: [fieldId], references: [id], onDelete: Cascade)
  version      Int // Auto-increment por fieldId (1, 2, 3...)
  title        String?
  body         String
  metadata     Json       @default("{}")
  publishedAt  DateTime? // null = borrador
  publishedFor CmsField[] @relation("PublishedFieldVersion")

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([fieldId, version])
  @@index([fieldId, createdAt])
}

// Campos LISTA (roadmap B4, 2026-07-30): un CmsField cuyo `metadata` declara
// `listSchema` (ej. footer.legal.links: [{name:"label"},{name:"href"}]) se
// edita en el admin como filas con un input por subcampo — sin ver JSON.
// CmsListItem es la representación de EDICIÓN; al guardar, el service
// serializa el array a JSON y ese JSON queda como body/versión del CmsField,
// así que la lectura pública (lib/cms.ts) NO cambia.
model CmsListItem {
  id       String   @id @default(cuid())
  fieldId  String
  field    CmsField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  position Int
  values   Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fieldId, position])
}

// Mediateca CMS (roadmap B5, 2026-07-30): un asset de imagen en Supabase
// Storage (bucket público `cms-media`) con su metadata. Un CmsField de
// type IMAGE guarda en `body` el CmsMedia.id; la lectura pública
// (getCmsImage en lib/cms.ts) resuelve id → { url, alt, width, height } —
// la URL pública se DERIVA de bucket+path (no se guarda: sobrevive a
// cambios de proyecto/dominio de Supabase).
model CmsMedia {
  id        String   @id @default(cuid())
  bucket    String // "cms-media" (único hoy; queda abierto por si se separa otro)
  path      String   @unique // path dentro del bucket: "media/<uuid>.<ext>"
  alt       String // texto alternativo — obligatorio por a11y (WCAG 1.1.1)
  width     Int
  height    Int
  bytes     Int
  mime      String // MIME REAL sniffado por magic bytes (no el declarado por el cliente)
  createdBy String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ──────────────────────── PERSONALIZACIÓN (sub-bloque M) ────────────────────────
// Diferenciador #1 de Lucams_shop (CLAUDE.md mandato): editor canvas in-browser
// para que el cliente personalice cada producto con sus fotos + plantillas.
//
// Modelo conceptual:
//   - Product.personalizationKind: tipo de experiencia (PHOTO_PACK, CALENDAR_*, etc.)
//   - PersonalizationTemplate: plantillas pre-armadas por kind (canvas layouts).
//   - Design: el diseño que el cliente está creando/creó. Vincula a Cart/Order.
//   - DesignAsset: cada foto subida por el cliente (privada, RLS owner-only).
//
// ADR-035 (a documentar al cerrar M): "Estudio = corazón del producto, no add-on"

enum PersonalizationKind {
  PHOTO_PACK // N fotos requeridas, posiciones libres en canvas
  PHOTO_GRID // N fotos con grid fijo (ej. 2×3, 3×4)
  CALENDAR_PHOTO_MONTH // 12 fotos (una por mes) + año
  CALENDAR_PHOTO_HERO // 1 foto + planner mensual
  EVENT_FAVOR // texto evento + foto opcional + plantilla pre-armada
  BUSINESS_LOGO // logo + datos contacto (B2B publicitario)
  CUSTOM_DECOR // foto/frase + composición libre
  TEXT_ONLY // sin fotos, solo texto (frases motivacionales)
  NONE // producto NO personalizable (coleccionables prearmados)
}

// PLAN_CATALOG_V2 5.1 — modo de uso del template.
//   EDITABLE: cliente selecciona en estudio + completa con datos (foto/texto).
//   PREMADE:  diseño ya impreso, cliente lo compra tal cual sin estudio.
enum TemplateMode {
  EDITABLE
  PREMADE
}

enum DesignStatus {
  DRAFT // el cliente lo está construyendo, auto-save periódico
  READY // confirmado, listo para añadir al carrito o ya en cart
  USED_IN_ORDER // snapshot post-checkout, immutable
  ARCHIVED // soft-deleted por el customer (mi-cuenta → mis diseños)
}

// Moderación de contenido del diseño (ADR-062 P0-2). Print-on-demand: cada diseño
// personalizado se imprime y despacha físicamente, así que Lucy revisa TODOS antes de
// producir (evita imprimir contenido ilegal / que infrinja derechos). El gate bloquea
// el envío (SHIPPED) hasta APPROVED.
enum ModerationStatus {
  PENDING // sin revisar — estado inicial de todo diseño personalizado
  APPROVED // Lucy lo revisó y autorizó a producción
  REJECTED // contenido no apto para imprimir; se avisa al cliente con el motivo
}

model Design {
  id               String                   @id @default(cuid())
  customerId       String?
  customer         Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId        String? // anon flow, matches cart_session cookie
  productId        String
  product          Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  templateId       String?
  template         PersonalizationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status           DesignStatus             @default(DRAFT)
  // Moderación de contenido (ADR-062 P0-2). Todo diseño nace PENDING; Lucy lo aprueba/
  // rechaza en /admin/moderacion antes de que su pedido pueda marcarse SHIPPED.
  moderationStatus ModerationStatus         @default(PENDING)
  moderationReason String? // motivo del rechazo (visible al cliente en el email)
  moderatedAt      DateTime?
  moderatedById    String? // AdminUser.id que moderó (sin relación, como Order.refundedBy)
  // canvasData: Konva stage serialization. Estructura validada por features/
  // personalization/schemas.ts con Zod en cada save.
  canvasData       Json
  // previewUrl: snapshot compositado del grid completo (PNG público, bucket
  // design-previews). Visible en cart/order display al cliente. En V1
  // (legacy M.3) es snapshot 1080×1080 single. En V2 (M.3.b multi-slot) es
  // mosaico del grid completo.
  previewUrl       String?
  // productionUrl: V1 legacy single PNG 300 DPI privado. Para V2 está null
  // y la info de producción vive en productionUrls[]. Mantener nullable
  // por retrocompat — designs M.3 existentes siguen siendo descargables.
  productionUrl    String?
  // productionUrls: V2 (M.3.b) — N paths privados en bucket production-assets,
  // uno por imán físico del pack. Admin descarga el ZIP de N PNGs 300 DPI
  // para imprenta. Empty array hasta status=READY o USED_IN_ORDER.
  productionUrls   String[]                 @default([])
  // metadata: selección plantilla + marco + color + ajustes filtros foto-edit.
  metadata         Json                     @default("{}")
  // shareToken: link público read-only para colaboración (sub-bloque K+M
  // futuro: "compartí con tu pareja antes de comprar"). Genera en cliente.
  shareToken       String?                  @unique
  assets           DesignAsset[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  quoteItems       QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([customerId, status])
  @@index([sessionId, status])
  @@index([productId])
  @@index([templateId])
  @@index([status, updatedAt])
  // Cola de moderación: diseños pendientes ordenados por antigüedad.
  @@index([moderationStatus, createdAt])
}

model DesignAsset {
  id             String    @id @default(cuid())
  designId       String?
  design         Design?   @relation(fields: [designId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId      String?
  // storageUrl: Supabase Storage bucket customer-uploads (privado, RLS
  // owner-only). URL firmada con TTL 1h al cliente; admin con service role.
  storageUrl     String
  mimeType       String // image/jpeg | image/png | image/webp
  sizeBytes      Int
  width          Int
  height         Int
  exifStripped   Boolean   @default(false)
  malwareScanned Boolean   @default(false)

  // Consentimiento por-subida de derechos de imagen (Ley 1581 + plan de producción):
  // evidencia de que quien sube DECLARÓ tener derecho a usar la foto y autorizó su
  // impresión. Nullable → los assets previos a esta política quedan sin sellar (no se
  // reimprimen sin pasar por el gate de moderación manual, que sí existe).
  rightsAcceptedAt    DateTime?
  rightsPolicyVersion String?

  createdAt DateTime @default(now())

  @@index([designId])
  @@index([customerId, createdAt])
  @@index([sessionId, createdAt])
}

model PersonalizationTemplate {
  id          String              @id @default(cuid())
  // productId null = template global aplica a cualquier producto del kind.
  // productId set = template específico para ese producto.
  productId   String?
  product     Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind        PersonalizationKind
  // PLAN_CATALOG_V2 5.1 — modo de uso (EDITABLE en estudio | PREMADE compra-tal-cual).
  mode        TemplateMode        @default(EDITABLE)
  name        String // "Polaroid clásico", "Marco corazón rosa"
  slug        String              @unique
  // PLAN_CATALOG_V2 5.10 — descripción breve para PDP + bot AI.
  description String?
  previewUrl  String // thumbnail del template (Supabase Storage public)
  // canvasData: estructura base del canvas (capas, marcos, decoraciones).
  // EDITABLE: cliente la usa como punto de partida + reemplaza placeholders foto.
  // PREMADE: JSON simple con 1 capa "image" apuntando al previewUrl (decisión 5.7).
  canvasData  Json
  isActive    Boolean             @default(true)
  order       Int                 @default(0)
  designs     Design[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([kind, mode, isActive, order])
  @@index([productId, mode, isActive])
  @@index([mode, isActive])
}

// ──────────────────────── ADR-057 — Sets de fichas del abecedario ────────────────────────
//
// Cada "Set de fichas" es una colección de ilustraciones kawaii por letra (A de Ave,
// B de Burro…) que Lucy gestiona en el admin. El editor de nombre mapea cada letra
// escrita a su ficha. Modular: varios sets por idioma (kawaii animales, pastel, navideño…).
// Si falta la letra, el editor cae a un placeholder — nunca se rompe.

model LetterTileSet {
  id        String       @id @default(cuid())
  name      String // "Kawaii Animales · Español"
  language  String // "es" | "en" (el alfabeto es incluye Ñ; en no)
  isActive  Boolean      @default(true)
  isDefault Boolean      @default(false) // set por defecto para ese idioma
  order     Int          @default(0)
  tiles     LetterTile[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([language, isActive, isDefault])
}

model LetterTile {
  id       String        @id @default(cuid())
  setId    String
  set      LetterTileSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  char     String // "A", "Ñ", … (mayúscula)
  imageUrl String // ficha ilustrada (bucket público)
  label    String? // nombre del animalito ("Ave")
  order    Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([setId, char])
  @@index([setId, order])
}

// ADR-057 Fase B2 — Galería de diseños PREDISEÑADOS (imágenes listas que el cliente puede
// aplicar a un slot en el editor, en vez de subir su foto). Agrupados por `tag` (ej. "separadores")
// para reusar el mismo modelo en otros productos (fotoimanes, etc.). Admin-gestionable.
model DesignGalleryImage {
  id        String  @id @default(cuid())
  tag       String // agrupador: "separadores", "fotoimanes", …
  name      String // nombre visible ("Flores", "Frase motivadora")
  imageUrl  String // imagen del diseño (bucket público product-images)
  // Ola 21 — URL opcional de la cara B para productos de separadores (pares A/B).
  imageUrlB String?
  order     Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([tag, isActive, order])
}

// ──────────────────────── PLAN_CATALOG_V2 — TABLAS NUEVAS ────────────────────────

// PLAN_CATALOG_V2 1.5 / 2.10 — tags transversales por ocasión que cruzan categorías.
// Ej. "matrimonio" agrupa Recuerdos Matrimonio + Fotoimanes Corazón + Cuadro con Foto +
// Box Pareja + Glass Magnets. Cliente filtra por ocasión y ve productos de N categorías.
model OcasionTag {
  id                     String              @id @default(cuid())
  slug                   String              @unique
  name                   String
  // Descripción semántica (markdown 100-300 palabras) que alimenta al bot AI.
  // Ej. "Día de la Madre se celebra el 2do domingo de mayo en Colombia..."
  description            String              @db.Text
  // 1-12: mes en que destacar esta ocasión (auto-rotación menú header).
  // Null = sin mes específico (ej. Cumpleaños).
  monthHint              Int?
  // PLAN_CATALOG_V2 3.4 — rango sugerido de cantidad para esta ocasión.
  // Shape: { min: int, ideal: int, max: int }. Bot recomienda variant según.
  suggestedQuantityRange Json?
  isActive               Boolean             @default(true)
  order                  Int                 @default(0)
  products               ProductOcasionTag[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([isActive, order])
  @@index([monthHint])
}

// PLAN_CATALOG_V2 1.5 / 2.10 — pivot Product ↔ OcasionTag con rationale por par.
// Permite que el bot AI responda "Set Fotoimanes Corazón es ideal para matrimonio
// PORQUE es el regalo perfecto para los novios + invitados".
model ProductOcasionTag {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ocasionTagId String
  ocasionTag   OcasionTag @relation(fields: [ocasionTagId], references: [id], onDelete: Cascade)
  // Texto libre para que el bot justifique la sugerencia.
  rationale    String?

  createdAt DateTime @default(now())

  @@id([productId, ocasionTagId])
  @@index([ocasionTagId])
}

// PLAN_CATALOG_V2 6.10 — tracking de recomendaciones para evolucionar scoring.
// Cada call a /api/catalog/recommend, cross-sell cart, related PDP, o bot crea
// un log. Datos para medir CTR + conversión + tunear pesos del scoring (decisión 6.2).
model RecommendationLog {
  id               String    @id @default(cuid())
  sessionId        String // anon cart session UUID
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // "wizard" | "crosssell" | "related_pdp" | "api_bot" | "homepage_featured"
  queryType        String
  // Filtros / params usados en el query (JSON serializable).
  queryParams      Json
  // Productos sugeridos (slugs).
  recommendedSlugs String[]
  // Productos cliqueados por el cliente (slugs).
  clickedSlugs     String[]  @default([])
  // Productos efectivamente comprados de la sugerencia (slugs).
  purchasedSlugs   String[]  @default([])

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([customerId, createdAt])
  @@index([queryType, createdAt])
}

// ──────────────────────── REDIRECTS (SEO) ────────────────────────
//
// UrlRedirect — mapeo arbitrario admin-managed para redirects 301/302
// (URL legacy → URL nueva). Complementa product-redirects.ts (slugs de
// productos consolidados) que vive en código generado.
//
// Lucy usa esto cuando:
//   - Cambia un slug de categoría/blog/legal (SEO: no romper links externos)
//   - Migra contenido viejo (linktree, Instagram bio)
//   - Resuelve typos comunes con redirect ("/garantia" → "/legal/garantias")
//
// Lookup se hace en proxy.ts (Node runtime, Prisma directo) con cache
// in-memory de 60s para no martillear DB en cada request.
model UrlRedirect {
  id          String    @id @default(cuid())
  // Ruta de origen (sin host, sin query string). Ej: "/garantia",
  // "/blog/promocion-mama-2025". UNIQUE para evitar conflictos.
  fromPath    String    @unique
  // Destino: ruta interna ("/legal/garantias") o URL externa
  // ("https://otra.com/x"). Sin restricciones de scheme.
  toPath      String
  // 301 (permanent, SEO transfer) o 302 (temporary). Default 301.
  statusCode  Int       @default(301)
  // Opcional: descripción interna para Lucy (no se expone al cliente).
  description String?
  isActive    Boolean   @default(true)
  // Contador de hits — útil para detectar redirects obsoletos.
  hitCount    Int       @default(0)
  lastHitAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([fromPath, isActive, deletedAt])
  @@index([deletedAt])
}

// Wishlist / favoritos (palanca de ingreso, auditoría 2026-07-13). Un cliente logueado guarda
// productos para después.
model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
}

// "Avísame cuando vuelva" (palanca de ingreso). Suscripción por email a un producto agotado; el
// cron notifica al reponerse el stock. Funciona para anónimos (email) y logueados.
model BackInStockSubscription {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  email      String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([productId, email])
  @@index([productId, notifiedAt])
}

// ──────────────────────── COTIZACIONES (Etapa 1 — catálogo + WhatsApp) ────────────────────────
// Modo catálogo (NEXT_PUBLIC_STORE_MODE=catalog, docs/PLAN_SALIDA_PRODUCCION.md):
// el checkout se convierte en "cotización de 1 paso" — el cliente arma el carrito,
// deja sus datos y cierra por WhatsApp. SIN pagos en línea ni envíos integrados.
// Feature: apps/web/features/quotes.

// Ciclo de vida de la cotización (valores en inglés, convención del repo).
enum QuoteStatus {
  PENDING // recién creada desde el storefront, Lucy aún no contacta
  CONTACTED // Lucy ya habló con el cliente por WhatsApp
  CLOSED // venta concretada (cerrada por fuera de la tienda)
  DISCARDED // no prosperó (spam, sin respuesta, el cliente desistió)
}

model Quote {
  id                 String      @id @default(cuid())
  // Número humano "COT-XXXXXX" (6 chars alfanuméricos sin ambiguos, generado en
  // app — ver features/quotes/service.ts). Único; el create reintenta ante P2002.
  number             String      @unique
  status             QuoteStatus @default(PENDING)
  customerName       String
  // Móvil colombiano normalizado a 10 dígitos (sin +57 ni espacios).
  customerWhatsapp   String
  customerEmail      String?
  city               String
  department         String
  notes              String? // notas DEL CLIENTE (formulario público)
  // Notas internas del admin — NUNCA exponer en la vista pública por token
  // (getQuoteByToken las excluye con select explícito).
  internalNotes      String?
  // Centavos COP (mandato CLAUDE.md — nunca float). En Etapa 1 total == subtotal:
  // no hay envío calculado, cupones ni impuestos en la cotización.
  subtotal           Int
  total              Int
  // Token para vista pública /cotizacion/[token] (guest sin login, mismo patrón
  // que Order.publicAccessToken): 32 chars hex = crypto.randomBytes(16).
  publicAccessToken  String      @unique
  // Prueba de la autorización de tratamiento (Ley 1581 art. 9) SOBRE el registro que contiene la
  // PII: quién autorizó, cuándo y qué versión del aviso vio. Se guarda aquí además de en Consent
  // porque es la cotización la que materializa el dato personal; el ledger central puede depurarse
  // y el vínculo con la PII no debe perderse. Nullable: las cotizaciones anteriores a la casilla
  // (2026-07-21) no la tienen.
  dataConsentAt      DateTime?
  dataConsentVersion String?
  items              QuoteItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([status, createdAt])
  @@index([deletedAt])
}

// Snapshot de cada línea del carrito al cotizar. Los FKs son SetNull para que
// archivar/borrar un producto, variante o diseño NO rompa el histórico de la
// cotización (los nombres/precios quedan snapshoteados como texto, igual que
// OrderItem preserva customDesign tras borrar el Design).
model QuoteItem {
  id          String          @id @default(cuid())
  quoteId     String
  quote       Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  designId    String?
  design      Design?         @relation(fields: [designId], references: [id], onDelete: SetNull)
  productName String // snapshot — sobrevive aunque el producto se archive
  variantName String?
  unitPrice   Int // centavos COP, snapshot del cart al cotizar
  quantity    Int
  // Preview del Design personalizado (PNG público) si la línea es personalizada.
  previewUrl  String?

  createdAt DateTime @default(now())

  @@index([quoteId])
}

// Ola Admin 100% (Lucy 2026-07-26) — módulos Mayorista B2B y Materiales.

/// Nivel de precio mayorista B2B: a partir de `minQty` unidades, el precio por
/// unidad es `unitPrice` (centavos COP). Por producto (null = aplica a todo el
/// catálogo). El admin no técnico lo gestiona desde /admin/mayorista.
model WholesaleTier {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int
  unitPrice Int // centavos COP por unidad en este nivel
  note      String?
  isActive  Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([productId, isActive])
  @@index([deletedAt])
}

/// Material/insumo de producción (PET laminado, imán flexible, tinta, empaque…).
/// Stock en unidades con alerta de mínimo para el admin no técnico (/admin/materiales).
model Material {
  id          String  @id @default(cuid())
  name        String
  unit        String // "unidad", "pliego", "metro", "ml", "paquete"
  stock       Float   @default(0)
  minStock    Float   @default(0)
  costPerUnit Int? // centavos COP por unidad (para costos de fabricación)
  note        String?
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([isActive])
  @@index([deletedAt])
}
