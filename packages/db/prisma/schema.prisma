// Schema Prisma — Lucams_shop
//
// Fuente de spec: docs/ARCHITECTURE.md § Modelo de datos +
// docs/CONVENTIONS.md § DB — soft delete + audit fields + § DB —
// foreign keys cascade explícito + ADR-014 (reserva stock) +
// ADR-016 (rate-limit Postgres).
//
// Convenciones aplicadas:
//   - id: cuid()
//   - Precios: Int (centavos COP) — nunca float (mandato CLAUDE.md).
//   - Audit fields en TODA entidad MUTABLE: createdAt, updatedAt,
//     createdBy, updatedBy, deletedAt, deletedBy.
//   - Append-only logs (InventoryLog, LoyaltyTxn, AdminActionLog,
//     WebhookEvent, Referral, StockReservation): solo createdAt.
//   - Soft delete: filtrar por `deletedAt IS NULL` en repositories.
//   - onDelete explícito en cada relación.
//
// Tablas NO-Prisma (creadas vía supabase/migrations/*.sql):
//   - rate_limit_buckets, cache_entries (ADR-016): bajo nivel, snake_case.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────── ENUMS ────────────────────────

enum AdminRole {
  SUPERADMIN
  MANAGER
  FULFILLMENT
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  WOMPI
  COD
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum WebhookSource {
  WOMPI
  VENNDELO
  RESEND
}

// Documento de identidad / tributario colombiano (DIAN factura electrónica).
enum DocumentType {
  CC // Cédula de ciudadanía
  CE // Cédula de extranjería
  NIT // NIT empresa
  PP // Pasaporte
  TI // Tarjeta de identidad
}

// Responsabilidad tributaria DIAN simplificada — se expande si hace falta.
enum TaxResponsibility {
  PERSONA_NATURAL_NO_RESPONSABLE
  PERSONA_NATURAL_RESPONSABLE
  PERSONA_JURIDICA
}

// Estado de la factura electrónica DIAN para el Order.
enum DianStatus {
  NOT_REQUIRED
  PENDING
  SENT
  ACCEPTED
  REJECTED
}

// Scope de consentimiento Ley 1581 colombiana — granular para que el
// banner de cookies + newsletter + habeas data registren cada toggle
// por separado con su versión, IP, UA, fecha.
enum ConsentScope {
  COOKIES_NECESSARY // siempre on
  COOKIES_FUNCTIONAL
  COOKIES_ANALYTICS
  COOKIES_MARKETING
  NEWSLETTER
  MARKETING_PROFILING // perfilamiento (segmentación, recomendaciones)
  HABEAS_DATA // autorización general tratamiento de datos personales
}

// ──────────────────────── CMS (sub-bloque J) ────────────────────────

// Formato del cuerpo de un bloque CMS. La mayoría son MARKDOWN.
// HTML solo para tablas complejas (cookies/subprocesadores) con
// rehype-sanitize allowlist. TEXT para strings cortos sin estructura.
// JSON para arrays estructurados (futuro: steps de un proceso).
enum BlockFormat {
  MARKDOWN
  HTML
  TEXT
  JSON
}

// Categoría del bloque CMS para agrupar en el admin + filtrar en RAG.
enum BlockCategory {
  LEGAL // 8 páginas /legal/*
  HOME // hero, secciones, CTAs home
  FOOTER // tagline, newsletter copy
  EMPTY_STATE // 404, errores, carrito vacío, sin resultados
  COOKIES // banner Ley 1581 (sub-bloque E)
  FAQ // entradas /ayuda (sub-bloque E)
  SUPPORT // /contacto, /mi-cuenta/pedidos textos (sub-bloque E)
  MAINTENANCE // /maintenance page (sub-bloque E)
  EMAIL // templates react-email (sub-bloque G)
  MARKETING // banners promocionales, hero rotativo futuro
}

// Tipo de valor para SiteSetting (validación admin form + display).
enum SettingType {
  TEXT
  EMAIL
  URL
  NUMBER
  PHONE // WA en formato wa.me (sin + ni espacios)
  COLOR // futuro: hex code
  BOOLEAN // futuro: feature flags
}

// Categoría de SiteSetting para agrupar en el admin.
enum SettingCategory {
  CONTACT // email, WhatsApp, redes
  BUSINESS // horarios, ubicación, NIT (futuro)
  LEGAL // versiones policies, plazos
  COMMERCE // mínimo orden, días fabricación, cobertura
  SOCIAL // Instagram, TikTok URLs (mantenido separado)
  EXTERNAL // DPA links, gov URLs
  WHATSAPP // mensajes pre-armados
  COPYRIGHT // año, tagline, location
  SEO // titles/descriptions defaults
}

// ──────────────────────── IDENTIDAD ────────────────────────

model Customer {
  id                String             @id @default(cuid())
  email             String             @unique
  phone             String?
  firstName         String?
  lastName          String?
  supabaseUserId    String             @unique
  // Datos tributarios DIAN — opcionales en perfil, obligatorios en
  // checkout cuando se emite factura electrónica (Fase 7).
  documentType      DocumentType?
  documentNumber    String? // nullable porque se completa en checkout
  taxResponsibility TaxResponsibility?
  loyaltyPoints     Int                @default(0)
  referralCode      String             @unique
  referredById      String?
  referredBy        Customer?          @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         Customer[]         @relation("Referrals")
  addresses         Address[]
  orders            Order[]
  reviews           Review[]
  loyaltyTxns       LoyaltyTxn[]
  consents          Consent[]
  supportTickets    SupportTicket[]
  // Sub-bloque M — Estudio de Personalización (diferenciador #1)
  designs           Design[]
  designAssets      DesignAsset[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([documentType, documentNumber])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  line1      String
  line2      String?
  city       String
  department String
  zip        String?
  phone      String
  isDefault  Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([customerId, deletedAt])
}

model AdminUser {
  id             String    @id @default(cuid())
  supabaseUserId String    @unique
  email          String    @unique
  role           AdminRole
  isActive       Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([role, isActive])
}

// ──────────────────────── CATÁLOGO ────────────────────────

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("Subcategories")
  products    Product[]
  order       Int        @default(0)
  isActive    Boolean    @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([parentId])
}

model Product {
  id                    String                    @id @default(cuid())
  slug                  String                    @unique
  name                  String
  description           String
  basePrice             Int
  compareAtPrice        Int?
  cost                  Int?
  sku                   String                    @unique
  // Personalización (sub-bloque M)
  // - isPersonalizable: flag legacy. NONE = no personalizable. Mantenido por
  //   compat hasta migrar consumers a personalizationKind != NONE.
  // - personalizationKind: enum tipado fuerte. Define el tipo de experiencia
  //   de personalización (PHOTO_PACK, CALENDAR_PHOTO_MONTH, EVENT_FAVOR...).
  // - personalizationSchema: metadata específica por kind (ej. photoSlots:6,
  //   aspectRatio:"1:1", allowText:true) — JSON validado en runtime con Zod.
  isPersonalizable      Boolean                   @default(false)
  personalizationKind   PersonalizationKind       @default(NONE)
  personalizationSchema Json?
  images                String[]
  categoryId            String
  category              Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants              ProductVariant[]
  reviews               Review[]
  designs               Design[]
  templates             PersonalizationTemplate[]
  isActive              Boolean                   @default(true)
  isFeatured            Boolean                   @default(false)
  seoTitle              String?
  seoDescription        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([personalizationKind, isActive])
}

model ProductVariant {
  id            String             @id @default(cuid())
  productId     String
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  sku           String             @unique
  price         Int?
  stock         Int                @default(0)
  attributes    Json
  inventoryLogs InventoryLog[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reservations  StockReservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([productId, deletedAt])
  @@index([stock])
}

model InventoryLog {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  delta     Int
  reason    String
  orderId   String?
  createdAt DateTime       @default(now())
  createdBy String?

  @@index([variantId, createdAt])
}

// ──────────────────────── CARRITO Y ÓRDENES ────────────────────────

model Cart {
  id         String         @id @default(cuid())
  customerId String?
  sessionId  String         @unique
  currency   String         @default("COP")
  items      CartItem[]
  abandoned  AbandonedCart?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([customerId, deletedAt])
}

model CartItem {
  id           String         @id @default(cuid())
  cartId       String
  cart         Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  qty          Int
  unitPrice    Int
  // Personalización (sub-bloque M)
  // - designId: si el producto requiere personalización, apunta al Design
  //   draft/ready del cliente. NULL para productos NONE.
  // - customDesign: campo legacy mantenido para compat retroactiva con
  //   carritos pre-M. Nuevos carts usan designId. Deprecate en V2.
  designId     String?
  design       Design?        @relation(fields: [designId], references: [id], onDelete: SetNull)
  customDesign Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([designId])
}

model Order {
  id                    String        @id @default(cuid())
  number                String        @unique
  customerId            String?
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email                 String
  phone                 String
  shippingAddress       Json
  subtotal              Int
  discount              Int           @default(0)
  shipping              Int
  tax                   Int           @default(0)
  total                 Int
  currency              String        @default("COP")
  status                OrderStatus   @default(DRAFT)
  paymentMethod         PaymentMethod
  wompiTransactionId    String?
  venndeloShipmentId    String?
  trackingUrl           String?
  couponId              String?
  coupon                Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  notes                 String?
  items                 OrderItem[]
  // DIAN factura electrónica (Fase 7 implementa el envío; aquí el
  // schema queda ready para no remigrar después).
  billingDocumentType   DocumentType?
  billingDocumentNumber String?
  billingName           String?
  dianStatus            DianStatus    @default(NOT_REQUIRED)
  dianCufe              String? // CUFE devuelto por la DIAN
  dianXmlUrl            String? // URL del XML firmado

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([customerId, deletedAt])
  @@index([status, createdAt])
  @@index([wompiTransactionId])
  @@index([dianStatus])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  qty            Int
  unitPrice      Int
  // Personalización (sub-bloque M)
  // - designId: snapshot del Design en estado USED_IN_ORDER (immutable post-pago).
  //   Si el Design original se borra después, la order conserva customDesign +
  //   designAssetUrl como audit history.
  // - customDesign: copia JSON inmutable del Design.canvasData al confirmar el order.
  // - designAssetUrl: URL del PNG 300 DPI listo para impresión (Supabase Storage
  //   bucket production-assets).
  designId       String?
  design         Design?        @relation(fields: [designId], references: [id], onDelete: SetNull)
  customDesign   Json?
  designAssetUrl String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([designId])
}

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  value     Int
  minOrder  Int?
  maxUses   Int?
  usedCount Int        @default(0)
  validFrom DateTime
  validTo   DateTime
  isActive  Boolean    @default(true)
  orders    Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([code, isActive, deletedAt])
  @@index([validFrom, validTo])
}

// ──────────────────────── RESEÑAS ────────────────────────

model Review {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating     Int
  comment    String
  images     String[]
  // Datos del reseñador (snapshot al momento de la reseña — para
  // mostrar incluso si customer queda nullado por delete account).
  authorName String?
  authorCity String?
  isApproved Boolean   @default(false)
  // Marcar reseñas excepcionales para mostrar en la home + secciones
  // destacadas. Solo admin moderator setea featured=true.
  featured   Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([productId, isApproved, deletedAt])
  @@index([customerId])
  @@index([featured, isApproved])
}

// ──────────────────────── MARKETING / LOYALTY ────────────────────────

model AbandonedCart {
  id                 String    @id @default(cuid())
  cartId             String    @unique
  cart               Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  email              String
  lastReminderSentAt DateTime?
  recoveredAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recoveredAt, lastReminderSentAt])
}

model LoyaltyTxn {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  delta      Int
  reason     String
  orderId    String?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

model Referral {
  id            String    @id @default(cuid())
  referrerId    String
  referredEmail String
  status        String
  rewardedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([referrerId, status])
  @@index([referredEmail])
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  content        String
  coverImage     String?
  author         String
  publishedAt    DateTime?
  isPublished    Boolean   @default(false)
  seoTitle       String?
  seoDescription String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([isPublished, publishedAt])
  @@index([deletedAt])
}

// ──────────────────────── IDEMPOTENCIA / WEBHOOKS ────────────────────────

model WebhookEvent {
  id          String        @id @default(cuid())
  source      WebhookSource
  externalId  String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  @@unique([source, externalId])
  @@index([processedAt])
}

// ──────────────────────── RESERVA DE STOCK (ADR-014) ────────────────────────

model StockReservation {
  id        String         @id @default(cuid())
  orderId   String
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([expiresAt])
  @@index([orderId])
}

// ──────────────────────── AUDIT LOG ADMIN ────────────────────────

model AdminActionLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// ──────────────────────── CONSENTIMIENTO LEY 1581 ────────────────────────
// Registro granular de consentimiento del titular según Ley 1581.
// Cada toggle del banner cookies + newsletter + autorización general
// se persiste como una fila independiente con versión, IP, UA y fecha.
// Append-only: revocación crea nueva fila con accepted=false y
// `revokedAt` apuntando al toggle revocado.

model Consent {
  id         String       @id @default(cuid())
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Para guests/newsletter sin cuenta: identificamos por email.
  email      String?
  scope      ConsentScope
  accepted   Boolean
  // Versión del aviso de privacidad / términos que el titular vió
  // al consentir. Si cambia el aviso, requeríamos re-consentimiento.
  version    String
  ipAddress  String?
  userAgent  String?
  // Si revoca un consentimiento previo, apunta a su id.
  revokesId  String?
  revokes    Consent?     @relation("ConsentRevocations", fields: [revokesId], references: [id], onDelete: SetNull)
  revokedBy  Consent[]    @relation("ConsentRevocations")
  acceptedAt DateTime     @default(now())

  @@index([customerId, scope])
  @@index([email, scope])
  @@index([scope, acceptedAt])
}

// ──────────────────────── OBSERVABILIDAD ────────────────────────

// Reportes RUM (Real User Monitoring) — Web Vitals enviados desde
// `app/_vitals.tsx` con useReportWebVitals. Permite agregar por route
// y mostrar p50/p75/p95 en /admin/performance.

model WebVital {
  id        String   @id @default(cuid())
  name      String // "LCP" | "FID" | "CLS" | "INP" | "TTFB" | "FCP"
  value     Float
  rating    String // "good" | "needs-improvement" | "poor"
  delta     Float
  navType   String? // "navigate" | "reload" | "back-forward" | "prerender"
  route     String // path normalizado (e.g. "/producto/[slug]")
  sessionId String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([name, route, createdAt])
  @@index([route, createdAt])
}

// Eventos custom de funnel (add-to-cart, search, newsletter-signup,
// product-view) — alternativa propia a Google Analytics. Solo se
// escriben si el customer dió consentimiento ANALYTICS o MARKETING
// según el caso. Append-only.

model SiteEvent {
  id         String   @id @default(cuid())
  name       String // "cart.add" | "search.query" | "newsletter.signup" | "product.view" ...
  customerId String?
  sessionId  String?
  route      String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([customerId, createdAt])
  @@index([sessionId, createdAt])
}

// Reportes de error capturados client+server, deduplicados por
// fingerprint (SHA-1 de message + stack[:3]). Alternativa propia
// a Sentry (mandato CLAUDE.md sin Sentry hasta evaluar Fase 7).

model ErrorReport {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  message     String
  stack       String?
  url         String?
  userAgent   String?
  userId      String?
  digest      String?
  // count incrementa con cada ocurrencia del mismo fingerprint.
  count       Int       @default(1)
  status      String    @default("OPEN") // "OPEN" | "RESOLVED" | "IGNORED"
  metadata    Json      @default("{}")
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([status, lastSeenAt])
  @@index([fingerprint])
}

// Webhooks de Resend para tracking de email transaccional.
// Idempotente via WebhookEvent.unique([source, externalId]); aquí
// guardamos la versión normalizada por email destino para joins
// fáciles con Customer.

model EmailEvent {
  id         String   @id @default(cuid())
  resendId   String   @unique
  type       String // "email.sent" | "email.delivered" | "email.bounced" | "email.complained" | "email.opened" | "email.clicked"
  to         String
  fromEmail  String
  subject    String?
  metadata   Json     @default("{}")
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([to, occurredAt])
  @@index([type, occurredAt])
}

// ──────────────────────── SOPORTE ────────────────────────

model SupportTicket {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email      String
  name       String
  subject    String
  message    String
  status     String    @default("OPEN") // "OPEN" | "IN_PROGRESS" | "CLOSED"
  ip         String?
  userAgent  String?
  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@index([email])
}

// ──────────────────────── CMS BLOCKS ────────────────────────
// Contenido editable desde admin: prosa larga (legales, FAQ, hero copy,
// empty states). Versionado por save. Render via react-markdown en el
// storefront. Consumible por futuro chatbot RAG vía /api/cms/blocks.

model CmsBlock {
  id                 String            @id @default(cuid())
  key                String            @unique // "legal.privacidad", "home.hero.title"
  title              String? // Display interno en admin
  body               String // Cuerpo según `format` (markdown/html/text/json)
  format             BlockFormat       @default(MARKDOWN)
  category           BlockCategory
  description        String? // Notas para la editora: "Aparece en footer + /legal/*"
  metadata           Json              @default("{}")
  isPublished        Boolean           @default(false)
  publishedVersionId String? // Apunta a la versión actualmente publicada
  publishedVersion   CmsBlockVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           CmsBlockVersion[] @relation("BlockVersions")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([category, isPublished])
  @@index([key])
  @@index([deletedAt])
}

// Append-only: cada save crea una versión inmutable. Permite ver
// historial + revertir + cumplir auditoría legal de qué decía el
// aviso de privacidad un día específico.
model CmsBlockVersion {
  id           String      @id @default(cuid())
  blockId      String
  block        CmsBlock    @relation("BlockVersions", fields: [blockId], references: [id], onDelete: Cascade)
  version      Int // Auto-increment por blockId (1, 2, 3...)
  title        String?
  body         String
  format       BlockFormat
  metadata     Json        @default("{}")
  publishedAt  DateTime? // null = borrador
  publishedFor CmsBlock[]  @relation("PublishedVersion")

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([blockId, version])
  @@index([blockId, createdAt])
}

// ──────────────────────── SITE SETTINGS ────────────────────────
// Configurables atómicos (email, horario, número WA, plazos legales,
// versiones policies, URLs DPA, mensajes WhatsApp). NO versionado —
// AdminActionLog captura quién cambió qué cuándo.

model SiteSetting {
  id          String          @id @default(cuid())
  key         String          @unique // "CONTACT_EMAIL", "BUSINESS_HOURS"
  value       String
  valueType   SettingType     @default(TEXT)
  label       String // Display admin: "Email de contacto público"
  description String? // "Aparece en footer + /contacto + /legal/*"
  category    SettingCategory

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([category])
}

// ──────────────────────── PERSONALIZACIÓN (sub-bloque M) ────────────────────────
// Diferenciador #1 de Lucams_shop (CLAUDE.md mandato): editor canvas in-browser
// para que el cliente personalice cada producto con sus fotos + plantillas.
//
// Modelo conceptual:
//   - Product.personalizationKind: tipo de experiencia (PHOTO_PACK, CALENDAR_*, etc.)
//   - PersonalizationTemplate: plantillas pre-armadas por kind (canvas layouts).
//   - Design: el diseño que el cliente está creando/creó. Vincula a Cart/Order.
//   - DesignAsset: cada foto subida por el cliente (privada, RLS owner-only).
//
// ADR-035 (a documentar al cerrar M): "Estudio = corazón del producto, no add-on"

enum PersonalizationKind {
  PHOTO_PACK // N fotos requeridas, posiciones libres en canvas
  PHOTO_GRID // N fotos con grid fijo (ej. 2×3, 3×4)
  CALENDAR_PHOTO_MONTH // 12 fotos (una por mes) + año
  CALENDAR_PHOTO_HERO // 1 foto + planner mensual
  EVENT_FAVOR // texto evento + foto opcional + plantilla pre-armada
  BUSINESS_LOGO // logo + datos contacto (B2B publicitario)
  CUSTOM_DECOR // foto/frase + composición libre
  TEXT_ONLY // sin fotos, solo texto (frases motivacionales)
  NONE // producto NO personalizable (coleccionables prearmados)
}

enum DesignStatus {
  DRAFT // el cliente lo está construyendo, auto-save periódico
  READY // confirmado, listo para añadir al carrito o ya en cart
  USED_IN_ORDER // snapshot post-checkout, immutable
  ARCHIVED // soft-deleted por el customer (mi-cuenta → mis diseños)
}

model Design {
  id            String                   @id @default(cuid())
  customerId    String?
  customer      Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId     String? // anon flow, matches cart_session cookie
  productId     String
  product       Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  templateId    String?
  template      PersonalizationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status        DesignStatus             @default(DRAFT)
  // canvasData: Konva stage serialization. Estructura validada por features/
  // personalization/schemas.ts con Zod en cada save.
  canvasData    Json
  // previewUrl: snapshot compositado del grid completo (PNG público, bucket
  // design-previews). Visible en cart/order display al cliente. En V1
  // (legacy M.3) es snapshot 1080×1080 single. En V2 (M.3.b multi-slot) es
  // mosaico del grid completo.
  previewUrl    String?
  // productionUrl: V1 legacy single PNG 300 DPI privado. Para V2 está null
  // y la info de producción vive en productionUrls[]. Mantener nullable
  // por retrocompat — designs M.3 existentes siguen siendo descargables.
  productionUrl String?
  // productionUrls: V2 (M.3.b) — N paths privados en bucket production-assets,
  // uno por imán físico del pack. Admin descarga el ZIP de N PNGs 300 DPI
  // para imprenta. Empty array hasta status=READY o USED_IN_ORDER.
  productionUrls String[]                 @default([])
  // metadata: selección plantilla + marco + color + ajustes filtros foto-edit.
  metadata      Json                     @default("{}")
  // shareToken: link público read-only para colaboración (sub-bloque K+M
  // futuro: "compartí con tu pareja antes de comprar"). Genera en cliente.
  shareToken    String?                  @unique
  assets        DesignAsset[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([customerId, status])
  @@index([sessionId, status])
  @@index([productId])
  @@index([status, updatedAt])
}

model DesignAsset {
  id             String    @id @default(cuid())
  designId       String?
  design         Design?   @relation(fields: [designId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId      String?
  // storageUrl: Supabase Storage bucket customer-uploads (privado, RLS
  // owner-only). URL firmada con TTL 1h al cliente; admin con service role.
  storageUrl     String
  mimeType       String // image/jpeg | image/png | image/webp
  sizeBytes      Int
  width          Int
  height         Int
  exifStripped   Boolean   @default(false)
  malwareScanned Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([designId])
  @@index([customerId, createdAt])
  @@index([sessionId, createdAt])
}

model PersonalizationTemplate {
  id         String              @id @default(cuid())
  // productId null = template global aplica a cualquier producto del kind.
  // productId set = template específico para ese producto.
  productId  String?
  product    Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind       PersonalizationKind
  name       String // "Polaroid clásico", "Marco corazón rosa"
  slug       String              @unique
  previewUrl String // thumbnail del template (Supabase Storage public)
  // canvasData: estructura base del canvas (capas, marcos, decoraciones).
  // El cliente la usa como punto de partida + reemplaza placeholders foto.
  canvasData Json
  isActive   Boolean             @default(true)
  order      Int                 @default(0)
  designs    Design[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([kind, isActive, order])
  @@index([productId, isActive])
}
